<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    {% render 'css-variables' %}

    {% comment %}
      Shopify primary font preload (if used elsewhere)
    {% endcomment %}
    
    {% comment %}
      Google Fonts – Luxury Typography
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    {% comment %} Critical CSS {% endcomment %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}

    <style>
      /* ===== Luxury Global Typography ===== */

      h1, h2, h3, h4, h5 {
        font-family: 'Cormorant Garamond', serif;
        letter-spacing: 6px;
        font-weight: 400;
        text-transform: uppercase;
      }

      body, p, span, a, li, button {
        font-family: 'Inter', sans-serif;
        font-weight: 300;
        line-height: 1.8;
      }
    </style>

    {{ content_for_header }}

  </head>

  <body>

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

  </body>
</html>