<section class="ananas-grid">

  <div class="grid-header">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="grid">

    {% for block in section.blocks %}

      <a href="{{ block.settings.link }}" class="grid-item">

        <div class="grid-image">
          <img 
            src="{{ block.settings.image | image_url: width: 800 }}" 
            alt="{{ block.settings.title }}"
            loading="lazy"
          >
        </div>

        {% if block.settings.title != blank %}
          <h4>{{ block.settings.title }}</h4>
        {% endif %}

      </a>

    {% endfor %}

  </div>

</section>

{% stylesheet %}

/* SECTION */
.ananas-grid{
  padding:100px 20px;
  text-align:center;
  background:#fff;
}

/* HEADER */
.grid-header h2{
  font-family:'Bebas Neue', sans-serif;
  letter-spacing:4px;
  font-size:32px;
  margin-bottom:60px;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:25px;
  max-width:1200px;
  margin:auto;
}

/* ITEM */
.grid-item{
  text-decoration:none;
  color:black;
  display:block;
}

/* IMAGE */
.grid-image{
  overflow:hidden;
}

.grid-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:0.6s ease;
  display:block;
}

/* HOVER */
.grid-item:hover img{
  transform:scale(1.05);
}

/* TITLE */
.grid-item h4{
  margin-top:15px;
  font-size:13px;
  letter-spacing:2px;
  text-transform:uppercase;
}

/* MOBILE */
@media(max-width:768px){

  .grid{
    grid-template-columns:1fr 1fr;
    gap:15px;
  }

  .grid-header h2{
    font-size:26px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Ananas Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DISCOVER THE PIECES"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Grid Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Ananas Grid",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}