<section class="ananas-intro">

  <div class="intro-bg"></div>

  <div class="intro-inner">

    <h2>{{ section.settings.heading }}</h2>

    <h4>{{ section.settings.subheading }}</h4>

    <p>{{ section.settings.text }}</p>

  </div>

</section>

{% stylesheet %}

.ananas-intro{
  position:relative;
  padding:120px 20px;
  text-align:center;
  overflow:hidden;
  background:#fff;
}

/* CENTER CONTENT */
.intro-inner{
  max-width:900px;
  margin:auto;
}

/* HEADING */
.ananas-intro h2{
  font-family:'Bebas Neue', sans-serif;
  font-size:42px;
  letter-spacing:4px;
  margin-bottom:20px;
}

/* SUBHEADING */
.ananas-intro h4{
  font-size:14px;
  letter-spacing:3px;
  color:#444;
  margin-bottom:25px;
}

/* TEXT */
.ananas-intro p{
  font-family:'Beth Ellen', cursive;
  font-size:15px;
  line-height:1.8;
  letter-spacing:1.5px;
  color:#333;
}

/* BACKGROUND WATERMARK */
.intro-bg{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:300px;
  height:300px;
  background:url('{{ section.settings.bg_image | image_url }}') center no-repeat;
  background-size:contain;
  opacity:0.05;
  pointer-events:none;
}

/* MOBILE */
@media(max-width:768px){

  .ananas-intro{
    padding:80px 20px;
  }

  .ananas-intro h2{
    font-size:30px;
  }

  .ananas-intro p{
    font-size:13px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Ananas Intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ANANAS COLLECTION"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FEATURES OUR SIGNATURE REVERSE TECHNIQUE"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "INTRODUCING ANANAS—OUR SUMMER COLLECTION INSPIRED BY THE PLAYFUL ELEGANCE OF TROPICAL PINEAPPLES."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Pineapple (Watermark)"
    }
  ],
  "presets": [
    {
      "name": "Ananas Intro"
    }
  ]
}
{% endschema %}