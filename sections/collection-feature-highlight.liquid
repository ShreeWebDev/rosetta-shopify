<section class="sport-feature-highlight">

  <div class="feature-container">

    <div class="feature-image">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="">
      {% endif %}
    </div>

    <div class="feature-content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="feature-btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

  </div>

</section>

{% stylesheet %}

.sport-feature-highlight {
  padding: 120px 0;
}

.feature-container {
  width: 90%;
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 80px;
  align-items: center;
}

.feature-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.feature-content h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 36px;
  font-weight: 300;
  margin-bottom: 25px;
}

.feature-content p {
  font-family: 'Inter', sans-serif;
  line-height: 1.8;
  margin-bottom: 30px;
}

.feature-btn {
  display: inline-block;
  padding: 14px 40px;
  border: 1px solid #000;
  text-transform: uppercase;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.3em;
  text-decoration: none;
  color: #000;
  transition: all 0.4s ease;
}

.feature-btn:hover {
  background: #000;
  color: #fff;
}

@media(max-width: 900px) {

  .feature-container {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .sport-feature-highlight {
    padding: 80px 0;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Collection Feature High",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Performance Meets..." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Designed for those who..." },
    { "type": "text", "id": "button_label", "label": "Button Label" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [
    {
      "name": "Collection Feature Highlight"
    }
  ]
}
{% endschema %}