<section class="discover">

  <div class="discover-inner">

    <h2 class="discover-title reveal-discover">
      {{ section.settings.heading }}
    </h2>

    <div class="discover-grid">

      {% for block in section.blocks %}

        <a href="{{ block.settings.link }}" class="discover-card">

          <div class="discover-img-wrap">
            <img 
              src="{{ block.settings.image | image_url: width: 1000 }}" 
              alt="{{ block.settings.title }}"
              loading="lazy"
            >
          </div>

          <h3>{{ block.settings.title }}</h3>

        </a>

      {% endfor %}

    </div>

  </div>

</section>

{% stylesheet %}

/* FULL WIDTH */
.discover{
  width:100vw;
  margin-left:calc(-50vw + 50%);
  padding:120px 20px;
  background:#fff;
  text-align:center;
}

/* INNER */
.discover-inner{
  max-width:1100px;
  margin:auto;
}

/* TITLE */
.discover-title{
  font-family:'Bebas Neue', sans-serif;
  letter-spacing:4px;
  font-size:32px;
  margin-bottom:60px;
  opacity:0;
  transform:translateY(30px);
  transition:all .8s ease;
}

.reveal-discover.active{
  opacity:1;
  transform:translateY(0);
}

/* GRID */
.discover-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:40px;
}

/* CARD */
.discover-card{
  text-decoration:none;
  color:black;
  display:block;
}

/* IMAGE */
.discover-img-wrap{
  overflow:hidden;
}

.discover-img-wrap img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:1s ease;
}

/* HOVER EFFECT */
.discover-card:hover img{
  transform:scale(1.08);
}

/* TITLE */
.discover-card h3{
  margin-top:20px;
  font-size:14px;
  letter-spacing:2px;
  text-transform:uppercase;
}

/* MOBILE */
@media(max-width:768px){

  .discover-grid{
    grid-template-columns:1fr;
    gap:25px;
  }

  .discover-title{
    font-size:24px;
  }

}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", function(){

  const el = document.querySelector(".reveal-discover");

  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add("active");
      }
    });
  }, { threshold: 0.3 });

  if(el){
    observer.observe(el);
  }

});
</script>

{% schema %}
{
  "name": "Discover Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DISCOVER"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Discover Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Discover Section",
      "blocks": [
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}