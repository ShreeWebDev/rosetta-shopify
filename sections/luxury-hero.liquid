<section class="luxury-hero">

  <!-- Background Video -->
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline>
    <source src="{{ section.settings.video_url }}" type="video/mp4">
  </video>

  <!-- Overlay -->
  <div class="hero-overlay"></div>

  <!-- Content -->
  <div class="hero-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtext }}</p>

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="hero-btn">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

</section>

{% stylesheet %}

.luxury-hero {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
}

.hero-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
}

.hero-content {
  position: absolute;
  bottom: 120px;   /* bottom positioning */
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  color: white;
  width: 100%;
  padding: 0 20px;
  z-index: 2;
}

.hero-content h1 {
  font-size: 72px;
  margin-bottom: 20px;
}

.hero-content p {
  margin-bottom: 30px;
  font-size: 14px;
  letter-spacing: 3px;
}

.hero-btn {
  border: 1px solid white;
  padding: 14px 40px;
  color: white;
  text-decoration: none;
  letter-spacing: 3px;
  transition: 0.3s ease;
}

.hero-btn:hover {
  background: white;
  color: black;
}

/* Mobile */

@media (max-width: 768px) {

  .hero-content h1 {
    font-size: 32px;
    letter-spacing: 4px;
  }

  .hero-content p {
    font-size: 12px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Video Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4 link)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TIMELESS ELEGANCE"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "DISCOVER THE ART OF REFINED LUXURY"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Video Hero"
    }
  ]
}
{% endschema %}