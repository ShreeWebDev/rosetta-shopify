<section class="luxury-hero">

  <!-- Background Video -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline>
    <source src="{{ section.settings.video_url }}" type="video/mp4">
  </video>

  <!-- Dark Gradient Overlay -->
  <div class="hero-overlay"></div>

  <!-- Content -->
  <div class="hero-content">
    <h1 class="hero-heading">
      {{ section.settings.heading }}
    </h1>

    <p class="hero-subtext">
      {{ section.settings.subtext }}
    </p>

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="hero-btn">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

</section>


{% stylesheet %}

/* ===== HERO WRAPPER ===== */
.luxury-hero {
  position: relative;
  height: 100vh;
  width: 100vw;
  left: 49.4%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
}

/* ===== VIDEO ===== */
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== OVERLAY ===== */
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.65),
    rgba(0,0,0,0.35),
    rgba(0,0,0,0.15)
  );
}

/* ===== CONTENT ===== */
.hero-content {
  position: absolute;
  bottom: 50px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  color: #ffffff;
  width: 100%;
  padding: 0 20px;
  z-index: 2;
  animation: fadeUp 1.2s ease forwards;
  display: flex;
  flex-direction: column;
}

/* ===== HEADING ===== */
.hero-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: 72px;
  letter-spacing: 0.2em;
  font-weight: 300;
  margin-bottom: 20px;
}

/* ===== SUBTEXT ===== */
.hero-subtext {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  letter-spacing: 0.3em;
  font-weight: 300;
  margin-bottom: 30px;
  opacity: 0.85;
}

/* ===== BUTTON ===== */
.hero-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 48px;
  font-size: 12px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  border: 1px solid rgba(255,255,255,0.6);
  background: transparent;
  color: #ffffff;
  text-decoration: none;
  transition: all 0.4s ease;
}

.hero-btn:hover {
  background: #ffffff;
  color: #000000;
}

/* ===== FADE ANIMATION ===== */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translate(-50%, 40px);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .hero-heading {
    font-size: 56px;
  }
}

@media (max-width: 768px) {
  .hero-content {
    bottom: 70px;
  }

  .hero-heading {
    font-size: 34px;
    letter-spacing: 0.15em;
  }

  .hero-subtext {
    font-size: 12px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Luxury Video Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (MP4 link)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TIMELESS ELEGANCE"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "DISCOVER THE ART OF REFINED LUXURY"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Luxury Video Hero"
    }
  ]
}
{% endschema %}