<section class="home-collections">

  <div class="collections-wrapper">

    <!-- Heading -->
    <div class="collections-header">
      <span class="collections-subtitle">
        {{ section.settings.subtitle }}
      </span>

      <h2 class="collections-title">
        {{ section.settings.heading }}
      </h2>
    </div>

    <!-- Product Grid -->
    <div class="collections-grid">
      {% if section.settings.collection != blank %}
        {% assign selected_collection = collections[section.settings.collection] %}
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          
          <div class="collection-item">
            <a href="{{ product.url }}">
              <div class="collection-image">
                <img 
                  src="{{ product.featured_image | image_url: width: 800 }}" 
                  alt="{{ product.title }}"
                  loading="lazy">
              </div>
              <div class="collection-info">
                <h3>{{ product.title }}</h3>
              </div>
            </a>
          </div>

        {% endfor %}
      {% endif %}
    </div>

    <!-- Button -->
    {% if section.settings.button_label != blank %}
      <div class="collections-button">
        <a href="{{ selected_collection.url }}" class="btn-luxury">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>

</section>


{% stylesheet %}

.home-collections {
  padding: 120px 0;
  background: #f8f8f8;
}

.collections-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

/* Header */
.collections-header {
  text-align: center;
  margin-bottom: 80px;
}

.collections-subtitle {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 12px;
  opacity: 0.7;
}

.collections-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  letter-spacing: 0.1em;
  font-weight: 300;
}

/* Grid */
.collections-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
}

.collection-item {
  cursor: pointer;
  transition: transform 0.4s ease;
}

.collection-image {
  position: relative;
  aspect-ratio: 1/1;
  overflow: hidden;
  margin-bottom: 16px;
}

.collection-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.collection-item:hover img {
  transform: scale(1.08);
}

.collection-info h3 {
  text-align: center;
  font-family: 'Cormorant Garamond', serif;
  font-size: 16px;
  font-weight: 300;
  letter-spacing: 0.05em;
}

/* Button */
.collections-button {
  text-align: center;
  margin-top: 60px;
}

.btn-luxury {
  display: inline-block;
  padding: 14px 40px;
  border: 1px solid #000;
  text-transform: uppercase;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.3em;
  text-decoration: none;
  color: #000;
  transition: all 0.4s ease;
}

.btn-luxury:hover {
  background: #000;
  color: #fff;
}

/* Responsive */
@media (max-width: 1024px) {
  .collections-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .collections-title {
    font-size: 32px;
  }
}

@media (max-width: 768px) {
  .home-collections {
    padding: 80px 0;
  }

  .collections-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Home Collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Exclusive Pieces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "2025 NEW COLLECTION"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All Collection"
    }
  ],
  "presets": [
    {
      "name": "Home Collections"
    }
  ]
}
{% endschema %}