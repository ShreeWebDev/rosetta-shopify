<section class="luxury-split-2">

  <div class="split2-wrapper">

    <div class="split2-grid">

      <!-- LEFT SIDE -->
      <div class="split2-left">

        <!-- 2x2 GRID -->
        <div class="split2-collection-grid">
          {% for block in section.blocks %}
            <div class="split2-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 800 }}" 
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="split2-overlay"></div>
            </div>
          {% endfor %}
        </div>

        <!-- TEXT -->
        <div class="split2-text">
          <h3>{{ section.settings.heading }}</h3>
          <p>{{ section.settings.text }}</p>
        </div>

      </div>

      <!-- RIGHT SIDE -->
      <div class="split2-right">
        {% if section.settings.right_image != blank %}
          <img 
            src="{{ section.settings.right_image | image_url: width: 1600 }}"
            alt="Collection Image">
        {% endif %}
      </div>

    </div>

  </div>

</section>


{% stylesheet %}

.luxury-split-2 {
  padding: 120px 0;
  background: var(--color-background);
}

.split2-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

.split2-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* GRID */
.split2-collection-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-bottom: 60px;
}

.split2-item {
  position: relative;
  aspect-ratio: 1/1;
  overflow: hidden;
  cursor: pointer;
}

.split2-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.split2-item:hover img {
  transform: scale(1.07);
}

.split2-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0);
  transition: background 0.5s ease;
}

.split2-item:hover .split2-overlay {
  background: rgba(0,0,0,0.08);
}

/* TEXT */
.split2-text h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 26px;
  letter-spacing: 0.12em;
  margin-bottom: 20px;
}

.split2-text p {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 1.8;
  max-width: 520px;
}

/* RIGHT IMAGE */
.split2-right {
  min-height: 600px;
  overflow: hidden;
}

.split2-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* RESPONSIVE */
@media (max-width: 1024px) {

  .split2-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }

  .split2-right {
    min-height: 500px;
  }

}

@media (max-width: 768px) {

  .luxury-split-2 {
    padding: 80px 0;
  }

  .split2-collection-grid {
    gap: 16px;
    margin-bottom: 40px;
  }

  .split2-text h3 {
    font-size: 20px;
  }

  .split2-text p {
    font-size: 14px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Luxury Collection Split 2",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DISCOVER THE LATEST COLLECTIONS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph Text",
      "default": "Each Rosetta Fine Jewellery collection tells a story — of grace, strength, and timeless allure."
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Large Image"
    }
  ],
  "blocks": [
    {
      "type": "grid_image",
      "name": "Grid Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Grid Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Luxury Collection Split 2",
      "blocks": [
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" },
        { "type": "grid_image" }
      ]
    }
  ]
}
{% endschema %}