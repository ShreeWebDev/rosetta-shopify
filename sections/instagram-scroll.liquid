<section class="instagram-scroll">

  <div class="instagram-header">
    <p class="instagram-subtitle">
      {{ section.settings.subtitle }}
    </p>

    <h2 class="instagram-title">
      {{ section.settings.heading }}
    </h2>
  </div>

  <div class="instagram-track">
    {% for block in section.blocks %}
      <a href="{{ section.settings.instagram_link }}" 
         target="_blank" 
         class="instagram-item"
         {{ block.shopify_attributes }}>
        
        {% if block.settings.image != blank %}
          <img 
            src="{{ block.settings.image | image_url: width: 800 }}" 
            alt="Instagram post"
            loading="lazy">
        {% endif %}

      </a>
    {% endfor %}

    <!-- Duplicate for infinite scroll effect -->
    {% for block in section.blocks %}
      <a href="{{ section.settings.instagram_link }}" 
         target="_blank" 
         class="instagram-item">
        {% if block.settings.image != blank %}
          <img 
            src="{{ block.settings.image | image_url: width: 800 }}" 
            alt="Instagram post"
            loading="lazy">
        {% endif %}
      </a>
    {% endfor %}
  </div>

</section>


{% stylesheet %}

.instagram-scroll {
  padding: 80px 0;
  background: #ffffff;
  overflow: hidden;
}

.instagram-header {
  text-align: center;
  margin-bottom: 40px;
}

.instagram-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  opacity: 0.6;
  margin-bottom: 10px;
}

.instagram-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 30px;
  letter-spacing: 0.15em;
  font-weight: 300;
}

/* SCROLL TRACK */
.instagram-track {
  display: flex;
  gap: 20px;
  width: max-content;
  animation: scrollLoop 30s linear infinite;
}

.instagram-item {
  flex-shrink: 0;
  width: 260px;
  height: 260px;
  overflow: hidden;
}

.instagram-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.instagram-item:hover img {
  transform: scale(1.1);
}

/* Infinite animation */
@keyframes scrollLoop {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .instagram-item {
    width: 180px;
    height: 180px;
  }

  .instagram-title {
    font-size: 22px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Instagram Scroll",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Connect"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "INSTAGRAM @ROSETTA"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Profile Link"
    }
  ],
  "blocks": [
    {
      "type": "instagram_image",
      "name": "Instagram Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Instagram Scroll",
      "blocks": [
        { "type": "instagram_image" },
        { "type": "instagram_image" },
        { "type": "instagram_image" },
        { "type": "instagram_image" },
        { "type": "instagram_image" }
      ]
    }
  ]
}
{% endschema %}