<section class="plume-center-image">
  <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="">
</section>

{% stylesheet %}

.plume-center-image{
height:90vh;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Plume center-image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Plume center-image" }
  ]
}
{% endschema %}