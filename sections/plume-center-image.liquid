<section class="plume-center-image">
  <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="">
</section>

{% stylesheet %}

.plume-full-image{
  width:100vw;
  margin-left:calc(50% - 50vw);
}

.plume-full-image img{
  height:100vh;
  object-fit:cover;
  display:block;
  
}
section.plume-center-image {
    display: flex;
    justify-content: center;
    margin-top: 80px;
  margin-bottom:80px;
}
{% endstylesheet %}
{% schema %}
{
  "name": "Plume center-image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Plume center-image" }
  ]
}
{% endschema %}