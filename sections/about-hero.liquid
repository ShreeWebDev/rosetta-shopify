<section class="about-hero">

  {% if section.settings.image %}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" class="about-hero-bg">
  {% endif %}

  <div class="about-hero-content">
    <span class="hero-sub">{{ section.settings.subheading }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
  </div>

</section>

{% stylesheet %}

.about-hero {
  position: relative;
  height: 90vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:white;
}

.about-hero-bg {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.about-hero::after {
  content:"";
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.4);
}

.about-hero-content {
  position:relative;
  z-index:2;
  max-width:800px;
}

.about-hero h1 {
  font-family:'Cormorant Garamond', serif;
  font-size:56px;
  letter-spacing:0.15em;
}

.hero-sub {
  font-family:'Inter', sans-serif;
  letter-spacing:0.3em;
  font-size:12px;
  display:block;
  margin-bottom:20px;
}

.about-hero p {
  font-family:'Inter', sans-serif;
  margin-top:20px;
  letter-spacing:0.2em;
  font-size:13px;
}

{% endstylesheet %}

{% schema %}
{
  "name": "About Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background Image" },
    { "type": "text", "id": "subheading", "default": "EST. 1993", "label": "Subheading" },
    { "type": "text", "id": "heading", "default": "THE HOUSE OF ROSETTA", "label": "Heading" },
    { "type": "text", "id": "text", "default": "Where tradition meets modernity in the heart of Dubai", "label": "Text" }
  ],
  "presets":[{ "name":"About Hero"}]
}
{% endschema %}