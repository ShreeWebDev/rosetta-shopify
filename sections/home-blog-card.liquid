<section class="home-blog">

  <div class="blog-wrapper">

    <!-- Header -->
    <div class="blog-header">
      <span class="blog-subtitle">
        {{ section.settings.subtitle }}
      </span>

      <h2 class="blog-title">
        {{ section.settings.heading }}
      </h2>
    </div>

    <!-- Articles Grid -->
    <div class="blog-grid">
      {% if section.settings.blog != blank %}
        {% assign selected_blog = blogs[section.settings.blog] %}
        
        {% for article in selected_blog.articles limit: section.settings.posts_to_show %}
          
          <article class="blog-card">
            <a href="{{ article.url }}">

              <div class="blog-image">
                {% if article.image %}
                  <img 
                    src="{{ article.image | image_url: width: 1200 }}" 
                    alt="{{ article.title }}"
                    loading="lazy">
                {% endif %}
                <div class="blog-overlay"></div>
              </div>

              <div class="blog-content">

                {% if article.tags.size > 0 %}
                  <span class="blog-category">
                    {{ article.tags.first }}
                  </span>
                {% endif %}

                <h3 class="blog-article-title">
                  {{ article.title }}
                </h3>

                <span class="blog-readmore">
                  Read More
                </span>

              </div>

            </a>
          </article>

        {% endfor %}
      {% endif %}
    </div>

    <!-- View All -->
    {% if section.settings.button_label != blank %}
      <div class="blog-button">
        <a href="{{ selected_blog.url }}" class="btn-luxury">
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>

</section>


{% stylesheet %}

/* SECTION */
.home-blog {
  padding: 120px 0;
  background: #f8f8f8;
}

.blog-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

/* HEADER */
.blog-header {
  text-align: center;
  margin-bottom: 80px;
}

.blog-subtitle {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  margin-bottom: 12px;
  opacity: 0.7;
}

.blog-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 40px;
  font-weight: 300;
  letter-spacing: 0.1em;
}

/* GRID */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
}

.blog-card {
  cursor: pointer;
}

.blog-image {
  position: relative;
  aspect-ratio: 4/5;
  overflow: hidden;
  margin-bottom: 24px;
}

.blog-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.blog-card:hover img {
  transform: scale(1.08);
}

.blog-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.35),
    rgba(0,0,0,0.05),
    rgba(0,0,0,0)
  );
  opacity: 0;
  transition: opacity 0.4s ease;
}

.blog-card:hover .blog-overlay {
  opacity: 1;
}

/* CONTENT */
.blog-category {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  display: block;
  margin-bottom: 10px;
  opacity: 0.6;
}

.blog-article-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 300;
  margin-bottom: 16px;
  transition: color 0.3s ease;
}

.blog-card:hover .blog-article-title {
  color: #b38b59;
}

.blog-readmore {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

/* BUTTON */
.blog-button {
  text-align: center;
  margin-top: 60px;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .blog-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .blog-title {
    font-size: 32px;
  }
}

@media (max-width: 768px) {
  .home-blog {
    padding: 80px 0;
  }

  .blog-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Home Blog Section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Stories & Insights"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST NEWS & EVENTS"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Number of posts",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View All News"
    }
  ],
  "presets": [
    {
      "name": "Home Blog Section"
    }
  ]
}
{% endschema %}