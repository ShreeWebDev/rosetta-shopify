<section class="plume-text-block">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
</section>

{% schema %}
{
  "name": "Plume text-block",
  "settings": [
    { "type": "text", "id": "heading", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Description" }
  ]
}
{% endschema %}