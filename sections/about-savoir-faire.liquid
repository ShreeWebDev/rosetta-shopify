<section class="about-savoir">

  <div class="about-savoir-wrapper">

    <!-- Image -->
    <div class="about-savoir-image">
      {% if section.settings.image != blank %}
        <img 
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading }}">
      {% endif %}
    </div>

    <!-- Content -->
    <div class="about-savoir-content">

      <span class="about-label">
        {{ section.settings.label }}
      </span>

      <h2 class="about-heading">
        {{ section.settings.heading }}
      </h2>

      <p class="about-quote">
        {{ section.settings.quote }}
      </p>

      <div class="about-author">
        <strong>{{ section.settings.author_name }}</strong>
        <span>{{ section.settings.author_title }}</span>
      </div>

    </div>

  </div>

</section>

{% stylesheet %}

.about-savoir {
  padding: 160px 0;
  background: #f4f4f4;
}

.about-savoir-wrapper {
  width: 90%;
  max-width: 1300px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 120px;
  align-items: center;
}

/* IMAGE */
.about-savoir-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

/* CONTENT */
.about-label {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  opacity: 0.6;
  display: block;
  margin-bottom: 20px;
}

.about-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  letter-spacing: 0.12em;
  margin-bottom: 40px;
}

.about-quote {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  font-style: italic;
  line-height: 1.8;
  margin-bottom: 40px;
  max-width: 520px;
}

.about-author strong {
  display: block;
  font-family: 'Inter', sans-serif;
  letter-spacing: 0.2em;
  font-size: 13px;
  margin-bottom: 6px;
}

.about-author span {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.2em;
  opacity: 0.7;
}

/* MOBILE */
@media (max-width: 900px) {
  .about-savoir-wrapper {
    grid-template-columns: 1fr;
    gap: 60px;
  }

  .about-heading {
    font-size: 32px;
  }

  .about-quote {
    font-size: 18px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "About Savoir-Faire",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Top Label",
      "default": "THE VISIONARY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "A WORD FROM THE FOUNDER"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote Text",
      "default": "Jewellery is not just an accessory; it is an emotion, a memory, a legacy passed down through generations."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author Name",
      "default": "ROSETTA FOUNDER"
    },
    {
      "type": "text",
      "id": "author_title",
      "label": "Author Title",
      "default": "Creative Director"
    }
  ],
  "presets": [
    {
      "name": "About Savoir-Faire"
    }
  ]
}
{% endschema %}