<section class="sport-full-banner">

  {% if section.settings.image %}
    <img 
      src="{{ section.settings.image | image_url: width: 2000 }}" 
      alt="">
  {% endif %}

</section>

{% stylesheet %}

.sport-full-banner {
  width: 100%;
  height: 70vh;
  overflow: hidden;
}

.sport-full-banner img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media(max-width:768px){
  .sport-full-banner{
    height: 50vh;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Collection Full Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner Image" }
  ],
  "presets": [
    {
      "name": "Collection Full Banner"
    }
  ]
}
{% endschema %}