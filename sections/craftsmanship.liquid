<section class="craftsmanship-section">

  <!-- Background Image -->
  {% if section.settings.background_image != blank %}
    <img 
      src="{{ section.settings.background_image | image_url: width: 2000 }}" 
      alt="Craftsmanship"
      class="craftsmanship-image">
  {% endif %}

  <!-- Gradient Overlay -->
  <div class="craftsmanship-overlay"></div>

  <!-- Content -->
  <div class="craftsmanship-content">
    <h2 class="craftsmanship-heading">
      {{ section.settings.heading }}
    </h2>

    <p class="craftsmanship-subtext">
      {{ section.settings.subtext }}
    </p>

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="craftsmanship-btn">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

</section>


{% stylesheet %}

/* SECTION WRAPPER */
.craftsmanship-section {
  position: relative;
  height: 100vh;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
}

/* BACKGROUND IMAGE */
.craftsmanship-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* GRADIENT */
.craftsmanship-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.6),
    rgba(0,0,0,0.2),
    rgba(0,0,0,0)
  );
}

/* CONTENT */
.craftsmanship-content {
  position: absolute;
  bottom: 80px;
  left: 0;
  right: 0;
  text-align: center;
  color: #ffffff;
  padding: 0 20px;
}

/* HEADING */
.craftsmanship-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: 40px;
  letter-spacing: 0.2em;
  font-weight: 300;
  margin-bottom: 16px;
}

/* SUBTEXT */
.craftsmanship-subtext {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  letter-spacing: 0.15em;
  font-weight: 300;
  opacity: 0.8;
  margin-bottom: 24px;
}

/* BUTTON */
.craftsmanship-btn {
  display: inline-block;
  padding: 12px 36px;
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  background: #ffffff;
  color: #000000;
  border: 1px solid #ffffff;
  text-decoration: none;
  transition: all 0.3s ease;
}

.craftsmanship-btn:hover {
  background: transparent;
  color: #ffffff;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .craftsmanship-heading {
    font-size: 32px;
  }
}

@media (max-width: 768px) {
  .craftsmanship-section {
    height: 60vh;
  }

  .craftsmanship-content {
    bottom: 50px;
  }

  .craftsmanship-heading {
    font-size: 22px;
  }

  .craftsmanship-subtext {
    font-size: 12px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Craftsmanship Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE ART OF CRAFTSMANSHIP"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Where tradition meets innovation"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship Banner"
    }
  ]
}
{% endschema %}