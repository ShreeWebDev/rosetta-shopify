<section class="craftsmanship-section">

  {% if section.settings.background_image != blank %}
    <img 
      src="{{ section.settings.background_image | image_url: width: 2000 }}" 
      alt="Craftsmanship"
      class="craftsmanship-image">
  {% endif %}

  <div class="craftsmanship-overlay"></div>

  <div class="craftsmanship-content">
    <h2 class="craftsmanship-heading">
      {{ section.settings.heading }}
    </h2>

    <p class="craftsmanship-subtext">
      {{ section.settings.subtext }}
    </p>

    {% if section.settings.button_label != blank %}
      <div class="btn-wrapper">
        <a href="{{ section.settings.button_link }}" class="craftsmanship-btn">
          {{ section.settings.button_label }}
        </a>
        
      </div>
    {% endif %}
  </div>

</section>

{% stylesheet %}
/* SECTION WRAPPER */
.craftsmanship-section {
  position: relative;
  height: 85vh; /* Standard Banner Height */
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
  display: flex;
  align-items: center; /* Text vertically center sathi */
  justify-content: center;
  margin-bottom: 80px;
}

/* BACKGROUND IMAGE */
.craftsmanship-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(100%); /* Image B&W asel tar luxury vatte */
}

/* OVERLAY */
.craftsmanship-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3); /* Subtle dark layer */
}

/* CONTENT */
.craftsmanship-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: #ffffff;
  padding: 0 20px;
}

/* HEADING - Spaced & Bold */
.craftsmanship-heading {
  font-size: 64px;
  letter-spacing: 0.3em;
  font-weight: 400;
  margin-bottom: 20px;
  text-transform: uppercase;
  line-height: 1.2;
}

/* SUBTEXT */
.craftsmanship-subtext {
  font-size: 18px;
  letter-spacing: 0.15em;
  font-weight: 300;
  margin-bottom: 40px;
  opacity: 0.9;
}

/* NEW GLASS BUTTON UI */
.btn-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
}

.craftsmanship-btn {
  display: inline-block;
  padding: 14px 45px;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.15); /* Glass effect */
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px; /* Pill shape */
  text-decoration: none;
  transition: all 0.4s ease;
}

.craftsmanship-btn:hover {
  background: rgba(255, 255, 255, 0.3);
  letter-spacing: 0.35em;
}



/* RESPONSIVE */
@media (max-width: 1024px) {
  .craftsmanship-heading { font-size: 42px; }
}

@media (max-width: 768px) {
  .craftsmanship-section { height: 70vh; }
  .craftsmanship-heading { font-size: 28px; letter-spacing: 0.2em; }
  .craftsmanship-subtext { font-size: 14px; }
  .craftsmanship-btn { padding: 12px 35px; }
}

{% endstylesheet %}



{% schema %}
{
  "name": "Craftsmanship Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE ART OF CRAFTSMANSHIP"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Where tradition meets innovation"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship Banner"
    }
  ]
}
{% endschema %}