<section class="about-family">

  <div class="about-family-wrapper">

    <!-- LEFT CONTENT -->
    <div class="about-family-content">

      <h2 class="about-family-heading">
        {{ section.settings.heading }}
      </h2>

      <div class="about-family-text">
        {{ section.settings.text }}
      </div>

    </div>

    <!-- RIGHT IMAGE -->
    <div class="about-family-image">
      {% if section.settings.image != blank %}
        <img 
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.heading }}">
      {% endif %}
    </div>

  </div>

</section>


{% stylesheet %}

/* SECTION */
.about-family {
  background: #f4f4f4;
  padding: 160px 0;
}

/* WRAPPER */
.about-family-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 120px;
  align-items: center;
}

/* TEXT SIDE */
.about-family-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: 46px;
  letter-spacing: 0.1em;
  font-weight: 300;
  margin-bottom: 40px;
}

.about-family-text {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 2;
  max-width: 520px;
  color: #444;
}

/* IMAGE SIDE */
.about-family-image img {
  width: 100%;
  height: 600px;
  object-fit: cover;
}

/* MOBILE */
@media (max-width: 900px) {
  .about-family-wrapper {
    grid-template-columns: 1fr;
    gap: 60px;
  }

  .about-family-image img {
    height: auto;
  }

  .about-family-heading {
    font-size: 32px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "About Family, Heritage...",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Family, heritage..."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Paragraph Text",
      "default": "<p>First generation jewellers...</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    }
  ],
  "presets": [
    {
      "name": "About Family Section"
    }
  ]
}
{% endschema %}