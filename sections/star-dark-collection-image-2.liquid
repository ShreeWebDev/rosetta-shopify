<section class="star-dark-image-02">

  <!-- Image -->
  <div class="star-dark-image-02-media">
    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 3000 }}"
        alt="{{ section.settings.heading }}"
        loading="lazy">
    {% endif %}
    <div class="star-dark-image-02-overlay"></div>
  </div>

  <!-- Text Content -->
  <div class="star-dark-image-02-content">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

</section>

{% stylesheet %}

.star-dark-image-02 {
  position: relative;
  background: #0b1a3a;
  color: #ffffff;
}

.star-dark-image-02-media {
  position: relative;
  height: 90vh;
  min-height: 650px;
  overflow: hidden;
}

.star-dark-image-02-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.star-dark-image-02-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(11,26,58,0.4),
    rgba(11,26,58,0.6),
    rgba(11,26,58,0.9)
  );
}

.star-dark-image-02-content {
  position: absolute;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  max-width: 900px;
  padding: 0 20px;
}

.star-dark-image-02-content h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  font-weight: 300;
  letter-spacing: 0.2em;
  line-height: 1.4;
}

/* Responsive */

@media (max-width: 1024px) {
  .star-dark-image-02-content h2 {
    font-size: 32px;
  }
}

@media (max-width: 768px) {

  .star-dark-image-02-media {
    height: 65vh;
  }

  .star-dark-image-02-content {
    bottom: 40px;
  }

  .star-dark-image-02-content h2 {
    font-size: 22px;
    letter-spacing: 0.12em;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Star Dark Image 02",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A COLLECTION BORN UNDER A LUCKY STAR"
    }
  ],
  "presets": [
    {
      "name": "Star Dark Image 02"
    }
  ]
}
{% endschema %}