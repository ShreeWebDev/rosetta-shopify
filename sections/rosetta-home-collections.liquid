<section class="rosetta-collections">

<div class="page-width">

<div class="rosetta-header">
<h2>{{ section.settings.heading }}</h2>
<p>{{ section.settings.text }}</p>
</div>

<div class="rosetta-grid">

{% for block in section.blocks %}

<a href="{{ block.settings.link }}" class="rosetta-card">

<div class="rosetta-image">

<img
src="{{ block.settings.image | image_url: width: 1200 }}"
alt="{{ block.settings.title }}"
>

<div class="rosetta-overlay">

<h3>{{ block.settings.title }}</h3>

<p class="rosetta-desc">
{{ block.settings.description }}
</p>

</div>

</div>

</a>

{% endfor %}

</div>

</div>

</section>

<style>

.rosetta-collections{
padding:80px 20px;
background:#f6f6f6;
text-align:center;
}

.page-width{
max-width:1500px;
margin:auto;
}

.rosetta-header h2{
font-size:28px;
letter-spacing:3px;
margin-bottom:20px;
}

.rosetta-header p{
max-width:700px;
margin:auto;
margin-bottom:80px;
}

.rosetta-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
}

.rosetta-card{
position:relative;
overflow:hidden;
display:block;
}

.rosetta-image{
position:relative;
aspect-ratio:4/5;
overflow:hidden;
}

/* image */

.rosetta-image img{
width:100%;
height:100%;
object-fit:cover;
transform:scale(0.82);
transition:transform 0.15s linear;
}

/* zoom origin */

.rosetta-card:nth-child(1) .rosetta-image img{
transform-origin:left center;
}

.rosetta-card:nth-child(2) .rosetta-image img{
transform-origin:right center;
}

/* gradient overlay */

.rosetta-image::after{
content:"";
position:absolute;
left:0;
bottom:0;
width:100%;
height:45%;
background:linear-gradient(to top, rgba(0,0,0,0.55), transparent);
}

/* text overlay */

.rosetta-overlay{
position:absolute;
bottom:40px;
left:50%;
transform:translateX(-50%);
color:white;
text-align:center;
width:80%;
z-index:2;
}

.rosetta-overlay h3{
letter-spacing:3px;
font-size:18px;
margin-bottom:10px;
}

.rosetta-desc{
opacity:0;
max-height:0;
transition:all .4s ease;
font-size:14px;
line-height:1.6;
}

/* hover reveal */

.rosetta-card:hover img{
opacity:.75;
}

.rosetta-card:hover .rosetta-desc{
opacity:1;
max-height:200px;
margin-top:10px;
}

/* responsive */

@media(max-width:768px){

.rosetta-grid{
grid-template-columns:1fr;
}

.rosetta-image{
height:420px;
}

.rosetta-desc{
opacity:1;
max-height:200px;
}

}

</style>

<script>

document.addEventListener("scroll", function(){

const section = document.querySelector(".rosetta-collections");
if(!section) return;

const rect = section.getBoundingClientRect();
const windowHeight = window.innerHeight;

/* section scroll progress */

const progress = (windowHeight - rect.top) / (windowHeight + rect.height);

/* clamp */

const clamped = Math.max(0, Math.min(progress, 1));

/* scale */

const scale = 0.82 + (clamped * 0.18);

document.querySelectorAll(".rosetta-image img").forEach(img=>{
img.style.transform = `scale(${scale})`;
});

});

</script>


{% schema %}
{
"name": "Rosetta Collections",
"settings":[
{
"type":"text",
"id":"heading",
"label":"Heading"
},
{
"type":"textarea",
"id":"text",
"label":"Paragraph"
}
],
"blocks":[
{
"type":"collection",
"name":"Collection Card",
"settings":[
{
"type":"image_picker",
"id":"image",
"label":"Image"
},
{
"type":"text",
"id":"title",
"label":"Title"
},
{
"type":"textarea",
"id":"description",
"label":"Description"
},
{
"type":"url",
"id":"link",
"label":"Link"
}
]
}
],
"max_blocks":2,
"presets":[
{
"name":"Rosetta Collections"
}
]
}
{% endschema %}