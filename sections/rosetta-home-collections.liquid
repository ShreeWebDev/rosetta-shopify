<section class="rosetta-collections">
  <div class="page-width">
    <div class="rosetta-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="rosetta-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="rosetta-card">
          <div class="rosetta-image">
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
            >
            <div class="rosetta-overlay">
              <h3>{{ block.settings.title }}</h3>
              <div class="rosetta-desc-wrapper">
                 <p class="rosetta-desc">{{ block.settings.description }}</p>
              </div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .rosetta-collections {
    padding: 100px 20px;
    background: #f6f6f6;
    text-align: center;
    overflow: hidden; /* Important for zoom effect */
  }

  .page-width {
    max-width: 1400px;
    margin: auto;
  }

  .rosetta-header h2 {
    font-size: 32px;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .rosetta-header p {
    max-width: 650px;
    margin: 0 auto 80px auto;
    line-height: 1.6;
    color: #444;
  }

  .rosetta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px; /* Thoda gap vadhvla ahe premium look sathi */
  }

  .rosetta-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
  }

  .rosetta-image {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #eee;
  }

  .rosetta-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Initial State */
    transform: scale(1.15); 
    will-change: transform;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); /* Lag-free feeling */
  }

  /* Gradient Overlay */
  .rosetta-image::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    z-index: 1;
    pointer-events: none;
  }

  .rosetta-overlay {
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    padding: 0 20px;
    color: white;
    text-align: center;
    z-index: 2;
  }

  .rosetta-overlay h3 {
    letter-spacing: 3px;
    font-size: 20px;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .rosetta-desc-wrapper {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.5s ease;
  }

  .rosetta-desc {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 10px;
  }

  /* Hover Effects */
  .rosetta-card:hover .rosetta-desc-wrapper {
    max-height: 150px;
    opacity: 1;
  }

  .rosetta-card:hover img {
    filter: brightness(0.9);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .rosetta-collections { padding: 60px 15px; }
    .rosetta-grid { grid-template-columns: 1fr; gap: 20px; }
    .rosetta-header p { margin-bottom: 40px; }
    .rosetta-desc-wrapper { max-height: 150px; opacity: 1; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.querySelector(".rosetta-collections");
    const cards = document.querySelectorAll(".rosetta-card img");

    if (!section || cards.length === 0) return;

    const handleScroll = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Check if section is in viewport
      if (rect.top < windowHeight && rect.bottom > 0) {
        // Calculate progress (0 to 1)
        const distance = windowHeight - rect.top;
        const totalHeight = windowHeight + rect.height;
        let progress = distance / totalHeight;

        // Clamp progress
        progress = Math.max(0, Math.min(progress, 1));

        // Logic: 1.15 (Entry) -> 1.0 (Middle/Exit)
        // 0.15 range cha zoom control
        const scale = 1.15 - (progress * 0.15);

        cards.forEach((img) => {
          img.style.transform = `scale(${scale.toFixed(4)})`;
        });
      }
    };

    // Optimization: Use requestAnimationFrame for smoother performance
    let isScrolling = false;
    window.addEventListener("scroll", () => {
      if (!isScrolling) {
        window.requestAnimationFrame(() => {
          handleScroll();
          isScrolling = false;
        });
        isScrolling = true;
      }
    });
    
    // Initial call
    handleScroll();
  });
</script>

{% schema %}
{
  "name": "Rosetta Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A NEW EXPRESSION OF MODERN CULTURE" },
    { "type": "textarea", "id": "text", "label": "Paragraph", "default": "Rosetta draws from the richness of modern culture to craft jewels..." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Rosetta Collections" }
  ]
}
{% endschema %}