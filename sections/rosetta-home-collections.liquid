<section class="rosetta-collections">
  <div class="page-width">
    <div class="rosetta-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="rosetta-grid" id="rosettaGrid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="rosetta-card">
          <div class="rosetta-image">
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
            >
            <div class="rosetta-overlay">
              <h3>{{ block.settings.title }}</h3>
              <div class="rosetta-desc-wrapper">
                 <p class="rosetta-desc">{{ block.settings.description }}</p>
              </div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .rosetta-collections {
    padding: 120px 20px;
    background: #f6f6f6;
    text-align: center;
    overflow: hidden;
  }

  .page-width {
    max-width: 1500px;
    margin: auto;
  }

  .rosetta-header h2 {
    font-size: 30px;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-transform: uppercase;
    font-weight: 400;
  }

  .rosetta-header p {
    max-width: 750px;
    margin: 0 auto 100px auto;
    line-height: 1.6;
    color: #333;
    font-size: 16px;
  }

  /* Flexbox for Expansion Logic */
  .rosetta-grid {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 120px; /* Starting large gap */
    width: 100%;
    transition: gap 0.1s linear; /* Smooth but responsive */
  }

  .rosetta-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    flex: 0 1 35%; /* Starting at approx 35-40% width */
    will-change: flex, gap;
  }

  .rosetta-image {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #e0e0e0;
  }

  .rosetta-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.1); /* Subtle internal zoom */
    will-change: transform;
  }

  /* Gradient Overlay */
  .rosetta-image::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
    z-index: 1;
    pointer-events: none;
  }

  .rosetta-overlay {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    padding: 0 20px;
    color: white;
    text-align: center;
    z-index: 2;
  }

  .rosetta-overlay h3 {
    letter-spacing: 3px;
    font-size: 18px;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .rosetta-desc-wrapper {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .rosetta-card:hover .rosetta-desc-wrapper {
    max-height: 100px;
    opacity: 1;
    margin-top: 10px;
  }

  /* Responsive Mobile */
  @media (max-width: 768px) {
    .rosetta-grid {
      flex-direction: column;
      gap: 30px !important; /* Stacked on mobile */
    }
    .rosetta-card {
      flex: 0 1 100% !important;
      width: 100%;
    }
    .rosetta-desc-wrapper { opacity: 1; max-height: 100px; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.querySelector(".rosetta-collections");
    const grid = document.getElementById("rosettaGrid");
    const cards = document.querySelectorAll(".rosetta-card");

    if (!section || !grid || window.innerWidth < 769) return;

    const animateOnScroll = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Check if section is active in viewport
      if (rect.top < windowHeight && rect.bottom > 0) {
        // Calculate progress based on section center
        const scrollRange = windowHeight + rect.height;
        const scrollCurrent = windowHeight - rect.top;
        let progress = scrollCurrent / scrollRange;
        
        progress = Math.max(0, Math.min(progress, 1));

        // 1. GAP: 120px pasun 20px paryant kami hoil
        const currentGap = 120 - (progress * 100);
        grid.style.gap = `${currentGap}px`;

        // 2. WIDTH: Card size 35% pasun 50% paryant vadhun total 100% hoil
        const currentFlex = 35 + (progress * 15);
        
        // 3. IMAGE ZOOM: 1.1 pasun 1.0 (original size)
        const currentScale = 1.1 - (progress * 0.1);

        cards.forEach((card) => {
          card.style.flex = `0 1 ${currentFlex}%`;
          const img = card.querySelector("img");
          if(img) img.style.transform = `scale(${currentScale})`;
        });
      }
    };

    // Performance Optimization
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          animateOnScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Run once on load
    animateOnScroll();
  });
</script>

{% schema %}
{
  "name": "Rosetta Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A NEW EXPRESSION OF MODERN CULTURE" },
    { "type": "textarea", "id": "text", "label": "Paragraph", "default": "Rosetta draws from the richness of modern culture to craft jewels..." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Rosetta Collections" }
  ]
}
{% endschema %}