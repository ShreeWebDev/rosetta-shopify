<section class="sport-discover">

  <div class="sport-container">
    <h2>{{ section.settings.heading }}</h2>

    <div class="sport-discover-grid">
      {% for product in collection.products limit: 2 %}
        <div class="sport-item">
          <a href="{{ product.url }}">
            <img src="{{ product.featured_image | image_url: width: 800 }}">
            <h4>{{ product.title }}</h4>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>

</section>

{% stylesheet %}

.sport-discover {
  padding: 120px 0;
  text-align: center;
}

.sport-container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

.sport-discover-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 40px;
  margin-top: 60px;
}

.sport-discover-grid img {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
}

.sport-discover h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 28px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}

.sport-item h4 {
  font-family: 'Cormorant Garamond', serif;
  margin-top: 15px;
}

@media(max-width:768px){
  .sport-discover-grid{
    grid-template-columns: 1fr;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Sport Discover",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover" }
  ]
}
{% endschema %}