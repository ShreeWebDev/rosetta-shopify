<section class="star-editorial-hero">

  <div class="editorial-container">

    {% if section.settings.label != blank %}
      <div class="editorial-label">
        {{ section.settings.label }}
      </div>
    {% endif %}

    <h1 class="editorial-heading">
      {{ section.settings.heading }}
    </h1>

    {% if section.settings.text != blank %}
      <p class="editorial-description">
        {{ section.settings.text }}
      </p>
    {% endif %}

    {% if section.settings.image %}
      <div class="editorial-image">
        <img 
          src="{{ section.settings.image | image_url: width: 1600 }}" 
          alt="{{ section.settings.heading }}">
      </div>
    {% endif %}

  </div>

</section>

{% stylesheet %}

.star-editorial-hero {
  padding: 140px 0 120px;
  background: #0b0f18;
  color: #ffffff;
  text-align: center;
  position: relative;
  height: 100vh;
  width: 100vw;
  left: 49.4%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
}

.editorial-container {
  width: 90%;
  max-width: 900px;
  margin: 0 auto;
}

.editorial-label {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  opacity: 0.7;
  margin-bottom: 25px;
  text-transform: uppercase;
}

.editorial-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(42px, 6vw, 80px);
  font-weight: 300;
  letter-spacing: 0.15em;
  margin-bottom: 35px;
}

.editorial-description {
  font-family: 'Inter', sans-serif;
  font-size: 16px;
  line-height: 1.8;
  color: #cfcfcf;
  max-width: 700px;
  margin: 0 auto 70px;
}

.editorial-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
  display: block;
}

/* Responsive */
@media (max-width: 768px) {

  .star-editorial-hero {
    padding: 100px 0 80px;
  }

  .editorial-description {
    font-size: 15px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Star Editorial Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "ROSETTA HIGH JEWELLERY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "AN ALLURE IN MOTION"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bottom Image"
    }
  ],
  "presets": [
    {
      "name": "Star Editorial Hero"
    }
  ]
}
{% endschema %}