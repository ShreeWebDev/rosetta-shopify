<section class="collection-intro">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
</section>

{% stylesheet %}

.sport-intro {
  padding: 120px 0;
  background: #f5f5f5;
  text-align: center;
}

.sport-container {
  width: 90%;
  max-width: 900px;
  margin: 0 auto;
}

.sport-intro h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 36px;
  margin-bottom: 30px;
}

.sport-intro p {
  font-family: 'Inter', sans-serif;
  line-height: 1.8;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Sport Intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Paragraph" }
  ]
}
{% endschema %}

