<section class="sport-intro-section">

  <div class="sport-intro-wrapper">
    
    <h2 class="sport-intro-heading">
      {{ section.settings.heading }}
    </h2>

    <p class="sport-intro-text">
      {{ section.settings.text }}
    </p>

  </div>

</section>

{% stylesheet %}

.sport-intro-section {
  padding: 100px 0;
  background: var(--color-background, #ffffff);
}

.sport-intro-wrapper {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: center;
}

.sport-intro-heading {
  font-family: 'Cormorant Garamond', serif;
  font-size: 28px;
  letter-spacing: 0.15em;
  margin-bottom: 24px;
}

.sport-intro-text {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 1.8;
  color: #6b6b6b;
}

/* Responsive */
@media (min-width: 1024px) {

  .sport-intro-section {
    padding: 140px 0;
  }

  .sport-intro-heading {
    font-size: 34px;
  }

  .sport-intro-text {
    font-size: 17px;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "Sport Intro Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection 1932"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "The House’s Fine Jewellery Creation Studio draws inspiration..."
    }
  ],
  "presets": [
    {
      "name": "Sport Intro Section"
    }
  ]
}
{% endschema %}