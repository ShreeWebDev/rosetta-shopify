<section class="collection-hero">
  {% if section.settings.hero_image %}
    <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="">
  {% endif %}
  <div class="hero-content">
    <span>{{ section.settings.subtitle }}</span>
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.caption }}</p>
  </div>
</section>
{% stylesheet %}
section.collection-hero {
    position: relative;
    width: 100vw;
    left: 49.4%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
}
.sport-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
}
.sport-intro {
  background: #f7f6f4;
}
{% endstylesheet %}
{% schema %}
{
  "name": "Sport Collection Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "CHAPTER" },
    { "type": "text", "id": "title", "label": "Title", "default": "1932" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Allure Celeste Necklace" }
  ]
}
{% endschema %}