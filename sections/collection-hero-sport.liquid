<section class="luxury-collection-hero">

  {% if section.settings.image %}
    <img 
      src="{{ section.settings.image | image_url: width: 2000 }}" 
      alt="{{ section.settings.heading }}">
  {% endif %}

  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="hero-inner">

      <div class="hero-label">
        {{ section.settings.label }}
      </div>

      <h1 class="hero-title">
        {{ section.settings.heading }}
      </h1>

      {% if section.settings.subheading != blank %}
        <div class="hero-subtitle">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

    </div>
  </div>

</section>

{% stylesheet %}

.luxury-collection-hero {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
}

.luxury-collection-hero img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Gradient Overlay */
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(11,26,58,0.7),
    rgba(11,26,58,0.4),
    rgba(0,0,0,0.6)
  );
}

/* Center Content */
.hero-content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.hero-inner {
  padding: 0 20px;
  color: white;
}

.hero-label {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.5em;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(48px, 8vw, 90px);
  letter-spacing: 0.15em;
  font-weight: 300;
}

.hero-subtitle {
  margin-top: 30px;
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(18px, 2.5vw, 28px);
  letter-spacing: 0.2em;
  opacity: 0.9;
}

/* Responsive */
@media (max-width: 768px) {
  .hero-title {
    letter-spacing: 0.1em;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Collection Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "1932"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "ALLURE CÉLESTE NECKLACE"
    }
  ],
  "presets": [
    {
      "name": "Luxury Collection Hero"
    }
  ]
}
{% endschema %}