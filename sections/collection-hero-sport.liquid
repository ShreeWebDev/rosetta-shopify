<section class="luxury-collection-hero">

  {% if section.settings.image %}
    <img 
      src="{{ section.settings.image | image_url: width: 2000 }}" 
      alt="{{ section.settings.heading }}">
  {% endif %}

  

  <div class="hero-content">
    <div class="hero-inner">

      <div class="hero-label">
        {{ section.settings.label }}
      </div>

      <h1 class="hero-title">
        {{ section.settings.heading }}
      </h1>

      {% if section.settings.subheading != blank %}
        <div class="hero-subtitle">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

    </div>
  </div>

</section>

{% stylesheet %}
section.luxury-collection-hero {
    position: relative;
    width: 100vw;
    left: 49.4%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
}
.luxury-collection-hero {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
}

.luxury-collection-hero img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Gradient Overlay */
.hero-overlay {
  position: absolute;
  inset: 0;
  
}

/* Center Content */
.hero-content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.hero-inner {
  padding: 0 20px;
  color: white;
}

/* COLLECTION */
.hero-label {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.35em;   /* 0.5em → thoda kami */
  margin-bottom: 8px;       /* 12px → tight */
  text-transform: uppercase;
}

/* 1932 */
.hero-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(48px, 8vw, 90px);
  letter-spacing: 0.12em;   /* 0.15em → subtle reduce */
  font-weight: 300;
  line-height: 1.05;        /* tighten vertical */
  margin: 0;
}

/* ALLURE CÉLESTE NECKLACE */
.hero-subtitle {
  margin-top: 14px;         /* 30px → major fix */
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(18px, 2.5vw, 28px);
  letter-spacing: 0.18em;   /* thoda refine */
  opacity: 0.9;
}

/* Responsive */
@media (max-width: 768px) {
  .hero-title {
    letter-spacing: 0.1em;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Collection Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "1932"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "ALLURE CÉLESTE NECKLACE"
    }
  ],
  "presets": [
    {
      "name": "Luxury Collection Hero"
    }
  ]
}
{% endschema %}