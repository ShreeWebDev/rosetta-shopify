<section class="venus-intro">

  <div class="venus-intro-inner reveal">

    <h2 class="venus-title fade-up delay-1">
      {{ section.settings.heading }}
    </h2>

    <p class="venus-sub fade-up delay-2">
      {{ section.settings.subheading }}
    </p>

    <p class="venus-desc fade-up delay-3">
      {{ section.settings.description }}
    </p>

  </div>

</section>

{% stylesheet %}

/* FULL WIDTH */
.venus-intro{
  width:100vw;
  margin-left:calc(-50vw + 50%);
  padding:120px 20px;
  background: radial-gradient(circle at center, #0f3d2e 0%, #06251b 100%);
  color:#fff;
  text-align:center;
  overflow:hidden;
}

/* INNER */
.venus-intro-inner{
  max-width:800px;
  margin:auto;
}

/* TEXT STYLES */
.venus-title{
  font-family:'Beth Ellen', cursive;
  font-size:42px;
  letter-spacing:4px;
  margin-bottom:25px;
}

.venus-sub{
  font-size:14px;
  letter-spacing:3px;
  text-transform:uppercase;
  opacity:0.85;
  margin-bottom:15px;
}

.venus-desc{
  font-size:13px;
  letter-spacing:2px;
  line-height:1.8;
  opacity:0.85;
  max-width:700px;
  margin:auto;
}

/* ANIMATION BASE */
.fade-up{
  opacity:0;
  transform:translateY(40px);
  transition:all .8s ease;
}

/* WHEN VISIBLE */
.reveal.active .fade-up{
  opacity:1;
  transform:translateY(0);
}

/* STAGGER DELAYS */
.delay-1{ transition-delay:.2s; }
.delay-2{ transition-delay:.4s; }
.delay-3{ transition-delay:.6s; }

/* MOBILE */
@media(max-width:768px){
  .venus-title{ font-size:28px; }
  .venus-intro{ padding:80px 20px; }
}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", function(){

  const reveals = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add("active");
      }
    });
  }, { threshold: 0.2 });

  reveals.forEach(el => observer.observe(el));

});
</script>

{% schema %}
{
  "name": "Venus Intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "VENUS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "LAYERS OF DIAMONDS, A STATEMENT OF EMERALD. TIMELESS."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "THE VENUS NECKLACE- AN ELEGANT LAYERED NECKLACE WITH A SUNFLOWER CUT EMERALD HIGHLIGHTED BY THE DIAMONDS."
    }
  ],
  "presets": [
    {
      "name": "Venus Intro"
    }
  ]
}
{% endschema %}