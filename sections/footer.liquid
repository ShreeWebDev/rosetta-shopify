<footer class="luxury-footer">

  <div class="footer-wrapper">

    <!-- Brand -->
    <h2 class="footer-logo">
      {{ section.settings.brand_name }}
    </h2>

    <span class="footer-subtitle">
      {{ section.settings.brand_tagline }}
    </span>

    <!-- Menu 1 -->
    {% if section.settings.menu_1 != blank %}
      <div class="footer-menu">
        {% for link in linklists[section.settings.menu_1].links %}
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Menu 2 -->
    {% if section.settings.menu_2 != blank %}
      <div class="footer-menu">
        {% for link in linklists[section.settings.menu_2].links %}
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Address -->
    <p class="footer-address">
      {{ section.settings.address }}
    </p>

  </div>

</footer>


{% stylesheet %}

.luxury-footer {
  background: #8B5CF6;
  color: #ffffff;
  padding: 100px 0;
  text-align: center;
}

.footer-wrapper {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

.footer-logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 36px;
  letter-spacing: 0.3em;
  font-weight: 300;
  margin-bottom: 6px;
}

.footer-subtitle {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  margin-bottom: 60px;
  opacity: 0.8;
}

.footer-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 25px 40px;
  margin-bottom: 40px;
}

.footer-menu a {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-decoration: none;
  color: #ffffff;
  transition: opacity 0.3s ease;
}

.footer-menu a:hover {
  opacity: 0.6;
}

.footer-address {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.15em;
  opacity: 0.8;
  margin-top: 40px;
}

/* Responsive */
@media (max-width: 768px) {
  .luxury-footer {
    padding: 70px 0;
  }

  .footer-logo {
    font-size: 26px;
  }

  .footer-subtitle {
    margin-bottom: 40px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "ROSETTA"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "FINE JEWELLERY"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Footer Menu 1"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Footer Menu 2"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "C. DE FERNANDO VI, 5, 28004 DUBAI, UAE"
    }
  ]
}
{% endschema %}