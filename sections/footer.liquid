<footer class="luxury-footer">
  <div class="footer-wrapper">
    
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="footer-logo-link">
        <img 
          src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135"
          alt="RFJ Logo"
          class="footer-logo-image"
          loading="lazy"
        >
      </a>
    </div>

    <div class="footer-main-grid">
      <div class="footer-column">
        <h4 class="footer-heading">{{ linklists[section.settings.menu_1].title }}</h4>
        <ul class="footer-links">
          {% for link in linklists[section.settings.menu_1].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-column">
        <h4 class="footer-heading">{{ linklists[section.settings.menu_2].title }}</h4>
        <ul class="footer-links">
          {% for link in linklists[section.settings.menu_2].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-column">
        <h4 class="footer-heading">{{ linklists[section.settings.menu_3].title }}</h4>
        <ul class="footer-links">
          {% for link in linklists[section.settings.menu_3].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="footer-column newsletter-col">
        <h4 class="footer-heading">{{ section.settings.newsletter_heading }}</h4>
        <p class="newsletter-text">{{ section.settings.newsletter_text }}</p>
        {% form 'customer', id: 'footer-newsletter' %}
          <div class="newsletter-form-group">
            <input type="email" name="contact[email]" placeholder="YOUR EMAIL" required>
            <button type="submit">JOIN</button>
          </div>
        {% endform %}
      </div>
    </div>

    <div class="footer-bottom">
      <div class="social-links">
        {% if section.settings.show_social %}
          <a href="{{ settings.social_instagram_link }}" target="_blank">INSTAGRAM</a>
          <a href="{{ settings.social_facebook_link }}" target="_blank">FACEBOOK</a>
          <a href="{{ settings.social_snapchat_link }}" target="_blank">SNAPCHAT</a>
        {% endif %}
      </div>
    </div>

  </div>
</footer>

{% stylesheet %}
.luxury-footer {
  background: #3b116b; /* Dark Purple as per image */
  color: #ffffff;
  padding: 80px 0 40px 0;
  width: 100%;
  overflow: hidden;
}

footer.luxury-footer {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
}

.footer-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

/* Logo Section */
.footer-brand {
  margin-bottom: 80px;
  text-align: center;
}

.footer-logo-image {
  max-width: 120px;
  filter: brightness(0) invert(1);
}

/* Grid Layout */
.footer-main-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
  text-align: left;
  margin-bottom: 60px;
}

.footer-heading {
  font-size: 14px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 25px;
  font-weight: 500;
  opacity: 0.9;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 12px;
}

.footer-links a {
  color: #ffffff;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0.7;
  transition: opacity 0.3s;
}

.footer-links a:hover {
  opacity: 1;
}

/* Newsletter Section */
.newsletter-text {
  font-size: 12px;
  line-height: 1.6;
  opacity: 0.7;
  margin-bottom: 20px;
}

.newsletter-form-group {
  display: flex;
  border-bottom: 1px solid rgba(255,255,255,0.3);
  padding-bottom: 5px;
}

.newsletter-form-group input {
  background: transparent;
  border: none;
  color: #fff;
  font-size: 11px;
  letter-spacing: 0.1em;
  width: 100%;
  outline: none;
}

.newsletter-form-group button {
  background: transparent;
  border: none;
  color: #fff;
  font-size: 11px;
  letter-spacing: 0.1em;
  cursor: pointer;
  padding-left: 10px;
}

/* Bottom Social Section */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.1);
  padding-top: 40px;
  text-align: left;
}

.social-links a {
  color: #fff;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.2em;
  margin-right: 30px;
  opacity: 0.8;
}

/* Responsive */
@media (max-width: 991px) {
  .footer-main-grid {
    grid-template-columns: 1fr 1fr;
    gap: 50px;
  }
}

@media (max-width: 768px) {
  .footer-main-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .newsletter-form-group {
    justify-content: center;
  }
  .footer-bottom {
    text-align: center;
  }
  .social-links a {
    margin: 0 15px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Footer Menu 1"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Footer Menu 2"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Footer Menu 3"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "NEWSLETTER"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Text",
      "default": "Join our world for the latest updates."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Links",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Luxury Footer"
    }
  ]
}
{% endschema %}