<footer class="luxury-footer">

  <div class="footer-wrapper">

    <!-- Brand Logo -->
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" class="footer-logo-link">
        <img 
          src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135"
          alt="RFJ Logo"
          class="footer-logo-image"
          loading="lazy"
        >
      </a>
    </div>

    <!-- Menu 1 -->
    {% if section.settings.menu_1 != blank %}
      <div class="footer-menu">
        {% for link in linklists[section.settings.menu_1].links %}
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Menu 2 -->
    {% if section.settings.menu_2 != blank %}
      <div class="footer-menu">
        {% for link in linklists[section.settings.menu_2].links %}
          <a href="{{ link.url }}">
            {{ link.title }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Address -->
    {% if section.settings.address != blank %}
      <p class="footer-address">
        {{ section.settings.address }}
      </p>
    {% endif %}

  </div>

</footer>


{% stylesheet %}

.luxury-footer {
  background: #8B5CF6;
  color: #ffffff;
  padding: 100px 0;
  text-align: center;

  position: relative;
  width: 100vw;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
}

.footer-wrapper {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

/* Brand */

.footer-brand {
  margin-bottom: 60px;
}

.footer-logo-link {
  display: inline-block;
}

.footer-logo-image {
  max-width: 240px;
  width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
  filter: brightness(0) invert(1); /* makes black SVG white */
  transition: opacity 0.3s ease;
}

.footer-logo-image:hover {
  opacity: 0.75;
}

/* Menus */

.footer-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 25px 40px;
  margin-bottom: 40px;
}

.footer-menu a {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-decoration: none;
  color: #ffffff;
  transition: opacity 0.3s ease;
}

.footer-menu a:hover {
  opacity: 0.6;
}

/* Address */

.footer-address {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.15em;
  opacity: 0.8;
  margin-top: 40px;
}

/* Responsive */

@media (max-width: 768px) {

  .luxury-footer {
    padding: 70px 0;
  }

  .footer-logo-image {
    max-width: 160px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Footer Menu 1"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Footer Menu 2"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "C. DE FERNANDO VI, 5, 28004 DUBAI, UAE"
    }
  ],
  "presets": [
    {
      "name": "Luxury Footer"
    }
  ]
}
{% endschema %}