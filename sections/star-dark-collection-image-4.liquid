<section class="star-dark-closeup-04">

  <!-- IMAGE -->
  <div class="star-dark-closeup-04-media">

    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 3000 }}"
        alt="{{ section.settings.title }}"
        loading="lazy">
    {% endif %}

    <div class="star-dark-closeup-04-overlay"></div>

    <!-- Tooltip Button -->
    <button class="star-dark-tooltip-btn-04" type="button">
      +
    </button>

    <!-- Tooltip -->
    <div class="star-dark-tooltip-04">
      <div class="star-dark-tooltip-inner-04">
        <p>{{ section.settings.tooltip_text }}</p>
        <button class="star-dark-tooltip-close-04" type="button">
          Close
        </button>
      </div>
    </div>

  </div>

  <!-- CONTENT -->
  <div class="star-dark-closeup-04-content">
    <h2 class="star-dark-closeup-04-title">
      {{ section.settings.title }}
    </h2>
    <p class="star-dark-closeup-04-text">
      {{ section.settings.text }}
    </p>
  </div>

</section>

{% stylesheet %}

.star-dark-closeup-04 {
  background: #0b1a3a;
  color: #ffffff;
  padding-bottom: 140px;
  position: relative;
}

.star-dark-closeup-04-media {
  position: relative;
  height: 90vh;
  min-height: 700px;
  overflow: hidden;
}

.star-dark-closeup-04-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.star-dark-closeup-04-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(11,26,58,0.3),
    rgba(11,26,58,0.4),
    rgba(11,26,58,0.9)
  );
}

/* Tooltip Button */

.star-dark-tooltip-btn-04 {
  position: absolute;
  top: 45%;
  right: 25%;
  width: 50px;
  height: 50px;
  border: 1px solid #ffffff;
  background: transparent;
  color: #ffffff;
  font-size: 24px;
  cursor: pointer;
  transition: 0.3s ease;
}

.star-dark-tooltip-btn-04:hover {
  background: #ffffff;
  color: #0b1a3a;
}

/* Tooltip */

.star-dark-tooltip-04 {
  position: absolute;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.8);
}

.star-dark-tooltip-04.active {
  display: flex;
}

.star-dark-tooltip-inner-04 {
  background: #0b1a3a;
  padding: 40px;
  max-width: 600px;
  text-align: center;
  border: 1px solid #ffffff;
}

.star-dark-tooltip-inner-04 p {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 25px;
}

.star-dark-tooltip-close-04 {
  border: 1px solid #ffffff;
  background: transparent;
  color: #ffffff;
  padding: 10px 30px;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 0.2em;
  cursor: pointer;
}

/* Content */

.star-dark-closeup-04-content {
  max-width: 900px;
  margin: 120px auto 0 auto;
  text-align: center;
  padding: 0 20px;
}

.star-dark-closeup-04-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  letter-spacing: 0.35em;
  font-weight: 300;
  margin-bottom: 20px;
}

.star-dark-closeup-04-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  letter-spacing: 0.08em;
  font-weight: 300;
  opacity: 0.9;
}

/* Responsive */

@media (max-width: 768px) {

  .star-dark-closeup-04-media {
    height: 65vh;
  }

  .star-dark-tooltip-btn-04 {
    right: 50%;
    transform: translateX(50%);
  }

  .star-dark-closeup-04-title {
    font-size: 28px;
  }

  .star-dark-closeup-04-text {
    font-size: 18px;
  }

}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", function() {

  const btn = document.querySelector(".star-dark-tooltip-btn-04");
  const tooltip = document.querySelector(".star-dark-tooltip-04");
  const close = document.querySelector(".star-dark-tooltip-close-04");

  if(btn){
    btn.addEventListener("click", function(){
      tooltip.classList.add("active");
    });
  }

  if(close){
    close.addEventListener("click", function(){
      tooltip.classList.remove("active");
    });
  }

});
</script>

{% schema %}
{
  "name": "Star Dark Closeup 04",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SUN"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "A precious interpretation of the sun."
    },
    {
      "type": "textarea",
      "id": "tooltip_text",
      "label": "Tooltip Text",
      "default": "With its detachable central line of diamonds that transforms into a bracelet."
    }
  ],
  "presets": [
    {
      "name": "Star Dark Closeup 04"
    }
  ]
}
{% endschema %}