<section class="star-product-discover">

  <div class="star-product-container">

    {% if section.settings.heading != blank %}
      <h2 class="star-product-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="star-product-grid">

      {% for block in section.blocks %}

        <div class="star-product-item" {{ block.shopify_attributes }}>

          {% assign product = block.settings.product %}

          {% if product.featured_image %}
            <div class="star-product-image">
              <img 
                src="{{ product.featured_image | image_url: width: 1000 }}" 
                alt="{{ product.title }}">
            </div>
          {% endif %}

          <div class="star-product-content">

            <h3 class="star-product-title">
              {% if block.settings.custom_title != blank %}
                {{ block.settings.custom_title }}
              {% else %}
                {{ product.title }}
              {% endif %}
            </h3>

            {% if block.settings.text != blank %}
              <p class="star-product-text">
                {{ block.settings.text }}
              </p>
            {% endif %}

            <a href="{{ product.url }}" class="star-product-button">
              {{ block.settings.button_label }}
            </a>

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

{% stylesheet %}

.star-product-discover {
  padding: 140px 0;
}

.star-product-container {
  width: 90%;
  max-width: 1300px;
  margin: 0 auto;
}

.star-product-heading {
  text-align: center;
  font-family: 'Cormorant Garamond', serif;
  font-size: 42px;
  letter-spacing: 0.15em;
  margin-bottom: 80px;
}

.star-product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
}

.star-product-image img {
  width: 100%;
  height: 420px;
  object-fit: cover;
}

.star-product-content {
  text-align: center;
  padding-top: 25px;
}

.star-product-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 18px;
  letter-spacing: 0.2em;
  margin-bottom: 15px;
  text-transform: uppercase;
}

.star-product-text {
  font-family: 'Inter', sans-serif;
  color: #555;
  margin-bottom: 25px;
  line-height: 1.7;
}

.star-product-button {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  text-decoration: none;
  border-bottom: 1px solid #000;
  padding-bottom: 5px;
  color: #000;
}

.star-product-button:hover {
  opacity: 0.7;
}

@media(max-width: 900px) {
  .star-product-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Star Collection Product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "ROSETTA HIGH JEWELLERY"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Product Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Paragraph Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Discover"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Star Collection Product Discover",
      "blocks": [
        { "type": "product_item" },
        { "type": "product_item" }
      ]
    }
  ]
}
{% endschema %}