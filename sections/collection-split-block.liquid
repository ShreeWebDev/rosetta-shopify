<section class="split-block {% if section.settings.reverse_layout %}reverse{% endif %}">
  <div class="split-image">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}">
    {% endif %}
  </div>

  <div class="split-text">
    <h3>{{ section.settings.heading }}</h3>
    <p>{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Collection Split Block",
  "settings": [
    { "type": "checkbox", "id": "reverse_layout", "label": "Reverse Layout", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ]
}
{% endschema %}