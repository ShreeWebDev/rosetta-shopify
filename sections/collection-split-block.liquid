<section class="sport-split {% if section.settings.reverse_layout %}reverse{% endif %}">

  <div class="sport-split-image">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1400 }}">
    {% endif %}
  </div>

  <div class="sport-split-text">
    <h3>{{ section.settings.heading }}</h3>
    <p>{{ section.settings.text }}</p>
  </div>

</section>

{% stylesheet %}

.sport-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  min-height: 80vh;
}

.sport-split.reverse {
  direction: rtl;
}

.sport-split.reverse .sport-split-text {
  direction: ltr;
}

.sport-split-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sport-split-text {
  padding: 80px;
}

.sport-split-text h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 32px;
  margin-bottom: 20px;
}

.sport-split-text p {
  font-family: 'Inter', sans-serif;
  line-height: 1.8;
}

@media(max-width:900px){
  .sport-split{
    grid-template-columns: 1fr;
  }
  .sport-split-text{
    padding: 40px 20px;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Sport Split Block",
  "settings": [
    { "type": "checkbox", "id": "reverse_layout", "label": "Reverse Layout", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ]
}
{% endschema %}