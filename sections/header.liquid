<header class="luxury-header" id="luxury-header">

  <div class="header-inner">
  
    <div class="header-left">
      <button class="mobile-toggle" id="mobileToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
  
      <a href="/pages/book-appointment" class="header-tool desktop-only">
        {{ 'CalendarTimeIcon.svg' | inline_asset_content }}
        <span>Book Appointment</span>
      </a>
  
      <a href="{{ routes.search_url }}" class="header-tool desktop-only">
        {{ 'SearchIcon.svg' | inline_asset_content }}
        <span>Search</span>
      </a>
    </div>
  
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo-image', loading: 'lazy', alt: shop.name }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135" alt="{{ shop.name }}" class="logo-image" loading="lazy">
        {% endif %}
      </a>
    </div>
  
    <div class="header-right">
      <a href="https://maps.google.com" class="header-tool icon-only">
        {{ 'LocationIcon.svg' | inline_asset_content }}
      </a>
      <a href="tel:+971000000000" class="header-tool icon-only">
        {{ 'PhoneIcon.svg' | inline_asset_content }}
      </a>
    </div>
  
  </div>

  <nav class="desktop-nav">
    <ul>
      {% for link in section.settings.menu.links %}
        
        {% assign mega_image = blank %}
        {% for block in section.blocks %}
          {% if block.settings.menu_item == link.title %}
            {% assign mega_image = block.settings.featured_image %}
          {% endif %}
        {% endfor %}

        <li class="nav-item">
          <a href="{{ link.url }}">{{ link.title }}</a>

          {% if link.links != blank %}
            
            {% assign has_right_image = false %}
            {% if mega_image != blank %}
              {% assign has_right_image = true %}
            {% elsif link.type == 'collection_link' and link.object.image != blank %}
              {% assign has_right_image = true %}
            {% endif %}

            <div class="mega-menu">
              <div class="mega-inner">
                <h3 class="mega-title">{{ link.title }}</h3>
                
                <div class="mega-grid {% if has_right_image == false %}center-mega-grid{% endif %}">
                  
                  <div class="mega-links">
                    {% for child in link.links %}
                      <a href="{{ child.url }}" class="mega-card">
                        
                        {% if child.type == 'collection_link' and child.object.image != blank %}
                          <img src="{{ child.object.image | image_url: width: 160, height: 160, crop: 'center' }}" alt="{{ child.title }}" loading="lazy">
                        {% elsif child.type == 'product_link' and child.object.featured_image != blank %}
                          <img src="{{ child.object.featured_image | image_url: width: 160, height: 160, crop: 'center' }}" alt="{{ child.title }}" loading="lazy">
                        {% else %}
                          <div class="mega-empty-circle">
                             <span>{{ child.title | slice: 0, 1 }}</span>
                          </div>
                        {% endif %}
                        
                        <span class="mega-link-title">{{ child.title }}</span>
                      </a>
                    {% endfor %}
                  </div>

                  {% if has_right_image %}
                    <div class="mega-featured-column">
                      {% if mega_image != blank %}
                        <img class="mega-feature" src="{{ mega_image | image_url: width: 600 }}" alt="{{ link.title }}" loading="lazy">
                      {% else %}
                        <img class="mega-feature" src="{{ link.object.image | image_url: width: 600 }}" alt="{{ link.title }}" loading="lazy">
                      {% endif %}
                    </div>
                  {% endif %}

                </div>
              </div>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>

  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-drawer">
      <div class="mobile-top">
        <button class="mobile-close" id="mobileClose">✕</button>
        <span class="mobile-account">
          {{ 'AccountIcon.svg' | inline_asset_content }}
        </span>
      </div>

      <div class="mobile-links">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="mobile-link">
            <span>{{ link.title }}</span>
            {% if link.links != blank %}
              <span class="arrow">›</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>

      <div class="mobile-divider"></div>

      <div class="mobile-links">
        <a href="/pages/contact-us">Contact Us</a>
        <a href="/pages/store">Find Store</a>
        <a href="/pages/book-appointment">Book an Appointment</a>
        <a href="/pages/wishlist">Wishlist</a>
        <a href="/account">My Account</a>
      </div>

      <div class="mobile-footer">
        <span>India · INR</span>
      </div>
    </div>
  </div>

</header>

{% stylesheet %}
/* HEADER */
.luxury-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: transparent;
  color: white;
  padding: 15px 0;
  transition: all .4s ease;
}

/* SCROLL */
.luxury-header.scrolled {
  background: white;
  color: black;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

/* HOVER */
.luxury-header.hovered {
  background: white;
  color: black;
}

/* GRID */
.header-inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 40px;
}

/* LEFT RIGHT */
.header-left,
.header-right {
  display: flex;
  align-items: center;
  gap: 25px;
}

.header-right {
  justify-content: end;
}

/* TOOLS */
.header-tool {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  letter-spacing: 1px;
  text-decoration: none;
  color: currentColor;
  text-transform: uppercase;
}

.header-tool svg {
  width: 25px;
  fill: currentColor;
}

/* LOGO */
.header-logo {
  text-align: center;
}

.logo-image {
  max-width: 170px;
  width: 100%;
  height: auto;
  display: block;
  margin: auto;
}
.logo-image {
  filter: brightness(0) invert(1);
  transition: .4s ease;
}

.luxury-header.scrolled .logo-image,
.luxury-header.hovered .logo-image {
  filter: none;
}

/* NAV */
.desktop-nav {
  padding-top: 15px;
}

.desktop-nav {
  padding-top: 15px;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all .4s ease;
}

.luxury-header.hovered .desktop-nav {
  max-height: 200px;
  opacity: 1;
}

.desktop-nav ul {
  display: flex;
  justify-content: center;
  gap: 35px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.desktop-nav a {
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: currentColor;
}

/* MEGA MENU FIXED LAYOUT */
.mega-menu {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 60px 0;
  opacity: 0;
  visibility: hidden;
  transition: .3s ease;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
}

.nav-item:hover .mega-menu {
  opacity: 1;
  visibility: visible;
}

.mega-inner {
  max-width: 1200px;
  margin: auto;
  padding: 0 40px;
  text-align: center; /* Center main title */
}

.mega-title {
  font-size: 16px;
  letter-spacing: 3px;
  margin-bottom: 40px;
  text-transform: uppercase;
}

/* Default Grid (With Image) */
.mega-grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: 80px;
  align-items: stretch;
}

/* Centered Grid (Without Image) */
.mega-grid.center-mega-grid {
  grid-template-columns: 1fr;
  justify-items: center;
}

.mega-links {
  display: flex;
  gap: 40px;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: flex-start;
}

/* Center sub-links when no right image */
.center-mega-grid .mega-links {
  justify-content: center;
}

.mega-featured-column {
  width: 100%;
  height: 420px;
}

.mega-feature {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Fallback Styling for Missing Images */
.mega-empty-circle {
  width: 160px;
  height: 160px;
  background: #f7f7f7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
  color: #ccc;
  font-family: serif;
  transition: .4s ease;
}

body {
  overflow-x: hidden;
}

.mega-card {
  text-decoration: none;
  color: black;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
}

.mega-card img {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  object-fit: cover;
  transition: .4s ease;
}

.mega-card:hover img,
.mega-card:hover .mega-empty-circle {
  transform: scale(1.05);
  box-shadow: 0 10px 20px rgba(0,0,0,0.05);
}

.mega-link-title {
  font-size: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
  text-align: center;
}

/* MOBILE MENU */
.mobile-menu {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: white;
  transform: translateX(-100%);
  transition: .35s ease;
  z-index: 200;
}

.mobile-menu.active {
  transform: translateX(0);
}

.mobile-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
}

.mobile-toggle span {
  width: 22px;
  height: 2px;
  background: currentColor;
}

.mobile-drawer {
  width: 100%;
  height: 100%;
  padding: 25px;
  display: flex;
  flex-direction: column;
}

.mobile-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
}

.mobile-links {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.mobile-link {
  display: flex;
  justify-content: space-between;
  text-decoration: none;
  font-size: 14px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: black;
}

.mobile-divider {
  height: 1px;
  background: #e5e5e5;
  margin: 30px 0;
}

.mobile-footer {
  margin-top: auto;
  font-size: 12px;
  letter-spacing: 2px;
  color: #777;
}

/* MOBILE RESPONSIVE */
@media(max-width: 768px) {
  .desktop-nav, .desktop-only { display: none; }
  .mobile-toggle { display: flex; }
  .header-inner { grid-template-columns: auto 1fr auto; padding: 0 20px; }
  .logo-image { max-width: 140px; }
  .mobile-menu { display: flex; }
}
{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", function(){
  const toggle = document.getElementById("mobileToggle");
  const menu = document.getElementById("mobileMenu");
  const close = document.getElementById("mobileClose");

  if(toggle){
    toggle.addEventListener("click", function(){
      menu.classList.add("active");
    });
  }

  if(close){
    close.addEventListener("click", function(){
      menu.classList.remove("active");
    });
  }
});
</script>

{% schema %}
{
  "name": "Luxury Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu Image",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu Item Title",
          "info": "Enter the exact name of the menu item (e.g., 'HIGH JEWELERY') to apply this image."
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "Right Column Featured Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Header"
    }
  ]
}
{% endschema %}