<header class="luxury-header" id="luxury-header">

<div class="header-inner">

<!-- LEFT -->
<div class="header-left">

<a href="/pages/book-appointment" class="header-tool">
{{ 'CalendarTimeIcon.svg' | inline_asset_content }}
<span>Book Appointment</span>
</a>

<a href="{{ routes.search_url }}" class="header-tool">
{{ 'SearchIcon.svg' | inline_asset_content }}
<span>Search</span>
</a>

</div>


<!-- LOGO -->
<div class="header-logo">
<a href="{{ routes.root_url }}">
{% if section.settings.logo != blank %}
{{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo-image', loading: 'lazy', alt: shop.name }}
{% else %}
<img
src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135"
alt="{{ shop.name }}"
class="logo-image"
loading="lazy">
{% endif %}
</a>
</div>


<!-- RIGHT -->
<div class="header-right">

<a href="https://maps.google.com" class="header-tool icon-only">
{{ 'LocationIcon.svg' | inline_asset_content }}
</a>

<a href="tel:+971000000000" class="header-tool icon-only">
{{ 'PhoneIcon.svg' | inline_asset_content }}
</a>

</div>

</div>


<!-- NAV -->
<nav class="desktop-nav">

<ul>

{% for link in section.settings.menu.links %}

<li class="nav-item">

<a href="{{ link.url }}">{{ link.title }}</a>

{% if link.links != blank %}

<div class="mega-menu">

<div class="mega-inner">

<h3 class="mega-title">{{ link.title }}</h3>

<div class="mega-grid">

{% for child in link.links %}

<a href="{{ child.url }}" class="mega-card">

{% if child.object.featured_image %}
<img
src="{{ child.object.featured_image | image_url: width: 400 }}"
alt="{{ child.title }}"
loading="lazy">
{% endif %}

<span>{{ child.title }}</span>

</a>

{% endfor %}

</div>

</div>

</div>

{% endif %}

</li>

{% endfor %}

</ul>

</nav>


<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
<div class="mobile-menu-inner">
{% for link in section.settings.menu.links %}
<a href="{{ link.url }}">{{ link.title }}</a>
{% endfor %}
</div>
</div>

</header>


{% stylesheet %}

/* HEADER */

.luxury-header{
position:fixed;
top:0;
left:0;
right:0;
z-index:100;
background:white;
color:black;
padding:15px 0;
box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

/* GRID */

.header-inner{
display:grid;
grid-template-columns:1fr auto 1fr;
align-items:center;
padding:0 40px;
}

/* LEFT RIGHT */

.header-left,
.header-right{
display:flex;
align-items:center;
gap:25px;
}

.header-right{
justify-content:end;
}

/* TOOLS */

.header-tool{
display:flex;
align-items:center;
gap:8px;
font-size:13px;
letter-spacing:1px;
text-decoration:none;
color:currentColor;
text-transform:uppercase;
}

.header-tool svg{
width:25px;
fill:currentColor;
}

/* LOGO */

.header-logo{
text-align:center;
}

.logo-image{
max-width:170px;
width:100%;
height:auto;
display:block;
margin:auto;
}

/* NAV */

.desktop-nav{
position:relative;
padding-top:15px;
}

.desktop-nav ul{
display:flex;
justify-content:center;
gap:35px;
list-style:none;
margin:0;
padding:0;
}

.desktop-nav a{
text-decoration:none;
font-size:13px;
letter-spacing:2px;
text-transform:uppercase;
color:currentColor;
}

/* NAV ITEM */

.nav-item{
position:relative;
}

/* MEGA MENU */

.mega-menu{
position:absolute;
top:40px;
left:50%;
transform:translateX(-50%);
width:100vw;
background:white;
padding:60px 0;
opacity:0;
visibility:hidden;
transition:.3s ease;
box-shadow:0 20px 40px rgba(0,0,0,0.08);
}

.nav-item:hover .mega-menu{
opacity:1;
visibility:visible;
}

.mega-inner{
max-width:1100px;
margin:auto;
text-align:center;
}

.mega-title{
font-size:16px;
letter-spacing:3px;
margin-bottom:40px;
text-transform:uppercase;
}

.mega-grid{
display:flex;
justify-content:center;
gap:70px;
}

.mega-card{
text-decoration:none;
color:black;
display:flex;
flex-direction:column;
align-items:center;
gap:15px;
}

.mega-card img{
width:160px;
height:160px;
border-radius:50%;
object-fit:cover;
transition:.4s ease;
}

.mega-card:hover img{
transform:scale(1.05);
}

.mega-card span{
font-size:14px;
letter-spacing:2px;
text-transform:uppercase;
}

/* MOBILE */

@media(max-width:768px){

.desktop-nav{
display:none;
}

.header-inner{
padding:0 20px;
}

.logo-image{
max-width:140px;
}

}

{% endstylesheet %}


{% schema %}

{
"name":"Luxury Header",
"settings":[
{
"type":"image_picker",
"id":"logo",
"label":"Logo"
},
{
"type":"link_list",
"id":"menu",
"label":"Main Menu",
"default":"main-menu"
}
],
"presets":[
{
"name":"Luxury Header"
}
]
}

{% endschema %}