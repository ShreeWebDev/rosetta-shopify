<header class="luxury-header" id="luxury-header">

  <div class="header-inner">

    <!-- Left -->
    <div class="header-left">
      <button class="mobile-toggle" id="mobileToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <a href="#" class="icon-btn search-btn">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>
    </div>

    <!-- Center Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}" class="logo-link">
        <img 
          src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135"
          alt="{{ shop.name }}"
          class="logo-image"
          loading="lazy">
      </a>
    </div>

    <!-- Right -->
    <div class="header-right">

      {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" class="icon-btn">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="icon-btn">
        {{ 'icon-cart.svg' | inline_asset_content }}
      </a>

    </div>

  </div>

  <!-- Desktop Expand Nav -->
  <nav class="desktop-nav">
    <ul>
      {% for link in section.settings.menu.links %}
      <li>
        <a href="{{ link.url }}">
          {{ link.title }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>

  <!-- Mobile Fullscreen Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-inner">
      {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  </div>

</header>

{% stylesheet %}

/* HEADER BASE */
.luxury-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  transition: all 0.4s ease;
  background: transparent;
  color: white;
}

/* When scrolled or hovered */
.luxury-header.scrolled,
.luxury-header.hovered {
  background: white;
  color: black;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

/* Layout */
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 40px;
}

.header-left,
.header-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

/* Logo */
.logo-image {
  max-width: 190px;
  height: auto;
  display: block;
  transition: 0.4s ease;
}

/* White logo at top */
.luxury-header .logo-image {
  filter: brightness(1) invert(0);
}

/* Black logo when scrolled */
.luxury-header.scrolled .logo-image,
.luxury-header.hovered .logo-image {
  filter: none;
}

/* Icons */
.icon-btn svg {
  width: 20px;
}

/* Desktop Nav */
.desktop-nav {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.4s ease;
}

.luxury-header.hovered .desktop-nav {
  max-height: 80px;
  opacity: 1;
  padding-bottom: 15px;
}

.desktop-nav ul {
  display: flex;
  justify-content: center;
  gap: 40px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.desktop-nav a {
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 2px;
  color: inherit;
}

/* Hamburger */
.mobile-toggle {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  cursor: pointer;
}

.mobile-toggle span {
  width: 20px;
  height: 1px;
  background: currentColor;
}

/* Mobile Menu */
.mobile-menu {
  position: fixed;
  inset: 0;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-100%);
  transition: 0.4s ease;
}

.mobile-menu.active {
  transform: translateY(0);
}

.mobile-menu-inner {
  display: flex;
  flex-direction: column;
  gap: 25px;
  text-align: center;
}

.mobile-menu-inner a {
  font-size: 18px;
  letter-spacing: 3px;
  text-decoration: none;
  color: black;
}

/* Responsive */
@media (max-width: 1024px) {
  .header-inner {
    padding: 18px 25px;
  }
}

@media (max-width: 768px) {

  .desktop-nav {
    display: none;
  }

  .mobile-toggle {
    display: flex;
  }

  .header-inner {
    padding: 15px 20px;
  }

  .logo-image {
    max-width: 140px;
  }

}

{% endstylesheet %}

<script>
document.addEventListener("DOMContentLoaded", function() {

  const header = document.getElementById("luxury-header");
  const toggle = document.getElementById("mobileToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  // Scroll effect
  document.addEventListener("scroll", function() {
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  });

  // Hover desktop
  header.addEventListener("mouseenter", function() {
    if (window.innerWidth > 768) {
      header.classList.add("hovered");
    }
  });

  header.addEventListener("mouseleave", function() {
    header.classList.remove("hovered");
  });

  // Mobile toggle
  toggle.addEventListener("click", function() {
    mobileMenu.classList.toggle("active");
  });

});
</script>

{% schema %}
{
  "name": "Luxury Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu"
    }
  ],
  "presets": [
    {
      "name": "Luxury Header"
    }
  ]
}
{% endschema %}