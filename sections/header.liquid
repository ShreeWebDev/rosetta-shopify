<header class="luxury-header" id="luxury-header">

  <div class="header-inner">

    <!-- LEFT -->
    <div class="header-left">

      <button class="mobile-toggle" id="mobileToggle">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <a href="/pages/book-appointment" class="header-tool desktop-only">
        {{ 'CalendarTimeIcon.svg' | inline_asset_content }}
        <span>Book Appointment</span>
      </a>

      <a href="{{ routes.search_url }}" class="header-tool desktop-only">
        {{ 'SearchIcon.svg' | inline_asset_content }}
        <span>Search</span>
      </a>

    </div>

    <!-- LOGO -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo-image', loading: 'lazy', alt: shop.name }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135" class="logo-image">
        {% endif %}
      </a>
    </div>

    <!-- RIGHT -->
    <div class="header-right">
      <a href="#" class="header-tool icon-only">
        {{ 'LocationIcon.svg' | inline_asset_content }}
      </a>
      <a href="tel:+971000000000" class="header-tool icon-only">
        {{ 'PhoneIcon.svg' | inline_asset_content }}
      </a>
    </div>

  </div>

  <!-- NAV -->
  <nav class="desktop-nav">
    <ul>
      {% for link in section.settings.menu.links %}
      <li class="nav-item">
        <a href="{{ link.url }}">{{ link.title }}</a>

        {% if link.links != blank %}
        <div class="mega-menu">
          <div class="mega-inner">

            <h3 class="mega-title">{{ link.title }}</h3>

            <div class="mega-grid">
              {% for child in link.links %}
              <a href="{{ child.url }}" class="mega-card">

                {% if child.object.featured_image %}
                <img src="{{ child.object.featured_image | image_url: width: 300 }}">
                {% endif %}

                <span>{{ child.title }}</span>
              </a>
              {% endfor %}
            </div>

          </div>
        </div>
        {% endif %}

      </li>
      {% endfor %}
    </ul>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-drawer">

      <div class="mobile-top">
        <button id="mobileClose">✕</button>
      </div>

      <div class="mobile-links">
        {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>

    </div>
  </div>

</header>

{% stylesheet %}

/* HEADER BASE */
.luxury-header{
position:fixed;
top:0;
left:0;
right:0;
z-index:999;
background:transparent;
color:white;
padding:15px 0;
transition:.4s;
}

/* SCROLL */
.luxury-header.scrolled{
background:white;
color:black;
box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

/* HOVER */
.luxury-header.hovered{
background:white;
color:black;
}

/* GRID */
.header-inner{
display:grid;
grid-template-columns:1fr auto 1fr;
align-items:center;
padding:0 40px;
}

/* LEFT RIGHT */
.header-left,
.header-right{
display:flex;
align-items:center;
gap:25px;
}
.header-right{justify-content:end;}

/* TOOL */
.header-tool{
display:flex;
gap:8px;
font-size:13px;
letter-spacing:1px;
text-decoration:none;
color:currentColor;
text-transform:uppercase;
}

/* LOGO */
.logo-image{
max-width:170px;
filter:brightness(0) invert(1);
transition:.4s;
}

.luxury-header.scrolled .logo-image,
.luxury-header.hovered .logo-image{
filter:none;
}

/* NAV */
.desktop-nav{
max-height:0;
opacity:0;
overflow:hidden;
transition:.4s;
}

.luxury-header.hovered .desktop-nav{
max-height:120px;
opacity:1;
}

.desktop-nav ul{
display:flex;
justify-content:center;
gap:35px;
list-style:none;
}

/* MEGA MENU */
.mega-menu{
position:absolute;
top:100%;
left:0;
width:100%;
background:white;
padding:60px 0;
opacity:0;
visibility:hidden;
transition:.3s;
}

.nav-item:hover .mega-menu{
opacity:1;
visibility:visible;
}

.mega-inner{
max-width:1200px;
margin:auto;
text-align:center;
}

.mega-grid{
display:flex;
justify-content:center;
gap:60px;
}

/* MOBILE */
.mobile-toggle{display:none;}

.mobile-menu{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:white;
transform:translateX(-100%);
transition:.3s;
}

.mobile-menu.active{
transform:translateX(0);
}

@media(max-width:768px){

.desktop-nav{display:none;}
.desktop-only{display:none;}
.mobile-toggle{display:flex;}

.header-inner{
grid-template-columns:auto 1fr auto;
padding:0 20px;
}

.logo-image{max-width:140px;}

}

{% endstylesheet %}

<script>

document.addEventListener("DOMContentLoaded",function(){

const header=document.getElementById("luxury-header");
const toggle=document.getElementById("mobileToggle");
const menu=document.getElementById("mobileMenu");
const close=document.getElementById("mobileClose");

/* SCROLL */
window.addEventListener("scroll",function(){
if(window.scrollY>50){
header.classList.add("scrolled");
}else{
header.classList.remove("scrolled");
}
});

/* HOVER */
header.addEventListener("mouseenter",function(){
if(window.innerWidth>768){
header.classList.add("hovered");
}
});

header.addEventListener("mouseleave",function(){
header.classList.remove("hovered");
});

/* MOBILE */
toggle.addEventListener("click",function(){
menu.classList.add("active");
});

close.addEventListener("click",function(){
menu.classList.remove("active");
});

});

</script>

{% schema %}
{
"name":"Luxury Header",
"settings":[
{
"type":"image_picker",
"id":"logo",
"label":"Logo"
},
{
"type":"link_list",
"id":"menu",
"label":"Main Menu",
"default":"main-menu"
}
],
"presets":[
{
"name":"Luxury Header"
}
]
}
{% endschema %}