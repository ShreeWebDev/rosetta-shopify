<header class="luxury-header" id="luxury-header">

<div class="header-inner">

<!-- LEFT -->
<div class="header-left">

<a href="/pages/book-appointment" class="header-tool">
{{ 'icon-calendar.svg' | inline_asset_content }}
<span>Book Appointment</span>
</a>

<a href="{{ routes.search_url }}" class="header-tool">
{{ 'SearchIcon.svg' | inline_asset_content }}
<span>Search</span>
</a>

</div>


<!-- LOGO -->
<div class="header-logo">
<a href="{{ routes.root_url }}">
{% if section.settings.logo != blank %}
{{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo-image', loading: 'lazy', alt: shop.name }}
{% else %}
<img
src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135"
alt="{{ shop.name }}"
class="logo-image"
loading="lazy">
{% endif %}
</a>
</div>


<!-- RIGHT -->
<div class="header-right">

<a href="https://maps.google.com" class="header-tool icon-only">
{{ 'icon-map-pin.svg' | inline_asset_content }}
</a>

<a href="tel:+971000000000" class="header-tool icon-only">
{{ 'icon-phone.svg' | inline_asset_content }}
</a>

</div>

</div>


<!-- NAV -->
<nav class="desktop-nav">
<ul>
{% for link in section.settings.menu.links %}
<li>
<a href="{{ link.url }}">{{ link.title }}</a>
</li>
{% endfor %}
</ul>
</nav>


<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
<div class="mobile-menu-inner">
{% for link in section.settings.menu.links %}
<a href="{{ link.url }}">{{ link.title }}</a>
{% endfor %}
</div>
</div>

</header>


{% stylesheet %}

/* Remove Shopify wrapper background */

.shopify-section-group-header-group{
background:transparent!important;
}


/* HEADER BASE */

.luxury-header{
position:fixed;
top:0;
left:0;
right:0;
z-index:100;
transition:all .4s ease;
background:transparent;
color:white;
padding:15px 0;
}


/* SCROLLED */

.luxury-header.scrolled,
.luxury-header.hovered{
background:white;
color:black;
box-shadow:0 10px 30px rgba(0,0,0,0.05);
}


/* GRID LAYOUT */

.header-inner{
display:grid;
grid-template-columns:1fr auto 1fr;
align-items:center;
padding:0 40px;
}


/* LEFT RIGHT */

.header-left,
.header-right{
display:flex;
align-items:center;
gap:25px;
}


/* TOOLS */

.header-tool{
display:flex;
align-items:center;
gap:8px;
font-size:13px;
letter-spacing:1px;
text-decoration:none;
color:currentColor;
text-transform:uppercase;
}

.header-tool svg{
width:18px;
fill:currentColor;
}


/* ICON ONLY */

.icon-only span{
display:none;
}


/* LOGO */

.header-logo{
text-align:center;
}

.logo-image{
max-width:170px;
width:100%;
height:auto;
display:block;
margin:auto;
transition:all .4s ease;
filter:brightness(0) invert(1);
}

.luxury-header.scrolled .logo-image,
.luxury-header.hovered .logo-image{
filter:none;
}


/* DESKTOP NAV */

.desktop-nav{
max-height:0;
opacity:0;
overflow:hidden;
transition:all .4s ease;
}

.luxury-header.hovered .desktop-nav{
max-height:80px;
opacity:1;
}

.desktop-nav ul{
display:flex;
justify-content:center;
gap:40px;
list-style:none;
padding:0;
margin:0;
}

.desktop-nav a{
text-decoration:none;
font-size:13px;
letter-spacing:2px;
text-transform:uppercase;
color:currentColor;
}


/* MOBILE TOGGLE */

.mobile-toggle{
display:none;
flex-direction:column;
gap:5px;
background:none;
border:none;
cursor:pointer;
}

.mobile-toggle span{
width:22px;
height:2px;
background:currentColor;
}


/* MOBILE MENU */

.mobile-menu{
position:fixed;
inset:0;
background:white;
display:flex;
align-items:center;
justify-content:center;
transform:translateY(-100%);
transition:.4s ease;
visibility:hidden;
}

.mobile-menu.active{
transform:translateY(0);
visibility:visible;
}

.mobile-menu-inner{
display:flex;
flex-direction:column;
gap:25px;
text-align:center;
}

.mobile-menu-inner a{
font-size:18px;
letter-spacing:3px;
text-decoration:none;
color:black;
text-transform:uppercase;
}


/* MOBILE */

@media(max-width:768px){

.desktop-nav{
display:none;
}

.header-tool span{
display:none;
}

.mobile-toggle{
display:flex;
}

.header-inner{
padding:0 20px;
}

.logo-image{
max-width:140px;
}

}

{% endstylesheet %}


<script>

document.addEventListener("DOMContentLoaded",function(){

const header=document.getElementById("luxury-header");
const toggle=document.getElementById("mobileToggle");
const mobileMenu=document.getElementById("mobileMenu");


document.addEventListener("scroll",function(){

if(window.scrollY>50){
header.classList.add("scrolled");
}
else{
header.classList.remove("scrolled");
}

});


header.addEventListener("mouseenter",function(){

if(window.innerWidth>768){
header.classList.add("hovered");
}

});


header.addEventListener("mouseleave",function(){

header.classList.remove("hovered");

});


if(toggle){

toggle.addEventListener("click",function(){

mobileMenu.classList.toggle("active");

});

}

});

</script>


{% schema %}

{
"name":"Luxury Header",
"settings":[
{
"type":"image_picker",
"id":"logo",
"label":"Logo"
},
{
"type":"link_list",
"id":"menu",
"label":"Main Menu",
"default":"main-menu"
}
],
"presets":[
{
"name":"Luxury Header"
}
]
}

{% endschema %}