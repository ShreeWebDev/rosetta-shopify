<header class="luxury-header" id="luxury-header">

<div class="header-inner">

<!-- LEFT -->
<div class="header-left">

<button class="mobile-toggle" id="mobileToggle">
<span></span>
<span></span>
<span></span>
</button>

<a href="/pages/book-appointment" class="header-tool desktop-only">
{{ 'CalendarTimeIcon.svg' | inline_asset_content }}
<span>Book Appointment</span>
</a>

<a href="{{ routes.search_url }}" class="header-tool desktop-only">
{{ 'SearchIcon.svg' | inline_asset_content }}
<span>Search</span>
</a>

</div>


<!-- LOGO -->
<div class="header-logo">
<a href="{{ routes.root_url }}">
{% if section.settings.logo != blank %}
{{ section.settings.logo | image_url: width: 400 | image_tag: class: 'logo-image', loading: 'lazy', alt: shop.name }}
{% else %}
<img
src="https://cdn.shopify.com/s/files/1/0668/0202/4491/files/rfj_logo.svg?v=1772525135"
alt="{{ shop.name }}"
class="logo-image"
loading="lazy">
{% endif %}
</a>
</div>


<!-- RIGHT -->
<div class="header-right">

<a href="https://maps.google.com" class="header-tool icon-only">
{{ 'LocationIcon.svg' | inline_asset_content }}
</a>

<a href="tel:+971000000000" class="header-tool icon-only">
{{ 'PhoneIcon.svg' | inline_asset_content }}
</a>

</div>

</div>


<!-- DESKTOP NAV -->
<nav class="desktop-nav">
<ul>

{% for link in section.settings.menu.links %}

<li class="nav-item">

<a href="{{ link.url }}">{{ link.title }}</a>

{% if link.links != blank %}

<div class="mega-menu">

<div class="mega-inner">

<h3 class="mega-title">{{ link.title }}</h3>

<div class="mega-grid">

{% for child in link.links %}

<a href="{{ child.url }}" class="mega-card">

{% if child.object.featured_image %}
<img
src="{{ child.object.featured_image | image_url: width: 400 }}"
alt="{{ child.title }}"
loading="lazy">
{% endif %}

<span>{{ child.title }}</span>

</a>

{% endfor %}

</div>

</div>

</div>

{% endif %}

</li>

{% endfor %}

</ul>
</nav>


<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">

<div class="mobile-drawer">

<div class="mobile-top">

<button class="mobile-close" id="mobileClose">✕</button>

<span class="mobile-account">
{{ 'AccountIcon.svg' | inline_asset_content }}
</span>

</div>


<div class="mobile-links">

{% for link in section.settings.menu.links %}

<div class="mobile-item">

<a href="{{ link.url }}" class="mobile-link">

<span>{{ link.title }}</span>

{% if link.links != blank %}
<span class="arrow">›</span>
{% endif %}

</a>

{% if link.links != blank %}

<div class="mobile-submenu">

{% for child in link.links %}

<a href="{{ child.url }}">{{ child.title }}</a>

{% endfor %}

</div>

{% endif %}

</div>

{% endfor %}

</div>


<div class="mobile-footer">

<span>India · INR</span>

</div>

</div>

</div>

</header>


{% stylesheet %}

/* HEADER */

.luxury-header{
position:fixed;
top:0;
left:0;
right:0;
z-index:100;
background:white;
color:black;
padding:15px 0;
box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

/* GRID */

.header-inner{
display:grid;
grid-template-columns:1fr auto 1fr;
align-items:center;
padding:0 40px;
}

/* LEFT RIGHT */

.header-left,
.header-right{
display:flex;
align-items:center;
gap:25px;
}

.header-right{
justify-content:end;
}

/* HAMBURGER */

.mobile-toggle{
display:none;
flex-direction:column;
gap:5px;
background:none;
border:none;
cursor:pointer;
}

.mobile-toggle span{
width:22px;
height:2px;
background:black;
}

/* NAV */

.desktop-nav{
position:relative;
padding-top:15px;
}

.desktop-nav ul{
display:flex;
justify-content:center;
gap:35px;
list-style:none;
margin:0;
padding:0;
}

/* MOBILE MENU */

.mobile-menu{
position:fixed;
inset:0;
background:white;
transform:translateX(-100%);
transition:.4s ease;
z-index:200;
}

.mobile-menu.active{
transform:translateX(0);
}

.mobile-drawer{
height:100%;
padding:25px;
display:flex;
flex-direction:column;
}

.mobile-top{
display:flex;
justify-content:space-between;
margin-bottom:30px;
}

.mobile-links{
display:flex;
flex-direction:column;
gap:20px;
}

.mobile-link{
display:flex;
justify-content:space-between;
text-decoration:none;
font-size:14px;
letter-spacing:2px;
text-transform:uppercase;
color:black;
}

.mobile-submenu{
display:none;
flex-direction:column;
gap:15px;
padding-left:15px;
margin-top:10px;
}

.mobile-item.active .mobile-submenu{
display:flex;
}

.mobile-footer{
margin-top:auto;
font-size:12px;
letter-spacing:2px;
color:#777;
}

/* MOBILE */

@media(max-width:768px){

.desktop-nav{
display:none;
}

.mobile-toggle{
display:flex;
}

.desktop-only{
display:none;
}

.header-inner{
grid-template-columns:auto 1fr auto;
padding:0 20px;
}

.logo-image{
max-width:140px;
}

}

{% endstylesheet %}


<script>

document.addEventListener("DOMContentLoaded",function(){

const toggle=document.getElementById("mobileToggle");
const menu=document.getElementById("mobileMenu");
const close=document.getElementById("mobileClose");

toggle.addEventListener("click",function(){
menu.classList.add("active");
});

close.addEventListener("click",function(){
menu.classList.remove("active");
});

document.querySelectorAll(".mobile-link").forEach(link=>{
link.addEventListener("click",function(e){

const parent=this.closest(".mobile-item");
const submenu=parent.querySelector(".mobile-submenu");

if(submenu){
e.preventDefault();
parent.classList.toggle("active");
}

});
});

});

</script>


{% schema %}

{
"name":"Luxury Header",
"settings":[
{
"type":"image_picker",
"id":"logo",
"label":"Logo"
},
{
"type":"link_list",
"id":"menu",
"label":"Main Menu",
"default":"main-menu"
}
],
"presets":[
{
"name":"Luxury Header"
}
]
}

{% endschema %}