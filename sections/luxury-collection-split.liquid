<section id="collections" class="luxury-split">

  <div class="split-wrapper">

    <div class="split-grid">

      <!-- LEFT SIDE -->
      <div class="split-left">

        <!-- 2x2 COLLECTION GRID -->
        <div class="collection-grid">

          {% for block in section.blocks %}
            <div class="collection-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 800 }}" 
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="collection-overlay"></div>
            </div>
          {% endfor %}

        </div>

        <!-- TEXT CONTENT -->
        <div class="split-text">
          <h3>{{ section.settings.heading }}</h3>
          <p>{{ section.settings.text }}</p>
        </div>

      </div>

      <!-- RIGHT SIDE LARGE IMAGE -->
      <div class="split-right">
        {% if section.settings.right_image != blank %}
          <img 
            src="{{ section.settings.right_image | image_url: width: 1600 }}"
            alt="Luxury collection">
        {% endif %}
      </div>

    </div>

  </div>

</section>


{% stylesheet %}

/* ===== SECTION ===== */
.luxury-split {
  padding: 120px 0;
  background: var(--color-background);
}

.split-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* ===== LEFT ===== */
.collection-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-bottom: 60px;
}

.collection-item {
  position: relative;
  aspect-ratio: 1/1;
  overflow: hidden;
  cursor: pointer;
}

.collection-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.collection-item:hover img {
  transform: scale(1.08);
}

.collection-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0);
  transition: background 0.5s ease;
}

.collection-item:hover .collection-overlay {
  background: rgba(0,0,0,0.08);
}

/* ===== TEXT ===== */
.split-text h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 26px;
  letter-spacing: 0.12em;
  margin-bottom: 20px;
}

.split-text p {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  line-height: 1.8;
  max-width: 520px;
}

/* ===== RIGHT IMAGE ===== */
.split-right {
  position: relative;
  min-height: 600px;
  overflow: hidden;
}

.split-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {

  .split-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }

  .split-right {
    min-height: 500px;
  }

}

@media (max-width: 768px) {

  .luxury-split {
    padding: 80px 0;
  }

  .collection-grid {
    gap: 16px;
    margin-bottom: 40px;
  }

  .split-text h3 {
    font-size: 20px;
  }

  .split-text p {
    font-size: 14px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "Luxury Collection Split",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DISCOVER THE LATEST COLLECTIONS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph Text",
      "default": "Each Rosetta Fine Jewellery collection tells a story — of grace, strength, and timeless allure."
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Large Image"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Luxury Collection Split",
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}