<section id="collections" class="luxury-split">
  <div class="split-wrapper">
    <div class="split-grid">

      <div class="split-left">
        <div class="collection-grid">
          {% for block in section.blocks %}
            <div class="collection-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 800 }}" 
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="collection-overlay"></div>
            </div>
          {% endfor %}
        </div>

        <div class="split-text">
          <h3>{{ section.settings.heading }}</h3>
          <div class="split-paragraph">
            <p>{{ section.settings.text }}</p>
          </div>
        </div>
      </div>

      <div class="split-right">
        {% if section.settings.right_image_link != blank %}
          <a href="{{ section.settings.right_image_link }}" class="right-image-anchor">
        {% endif %}

        {% if section.settings.right_image != blank %}
          <img 
            src="{{ section.settings.right_image | image_url: width: 1600 }}"
            alt="Luxury collection">
        {% endif %}

        {% if section.settings.right_image_link != blank %}
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
/* ===== SECTION ===== */
.luxury-split {
  padding: 120px 0;
  background: #fff;
}

.split-wrapper {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

.split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px; /* Slightly increased gap for luxury feel */
  align-items: center;
}

/* ===== LEFT ===== */
.collection-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-bottom: 60px;
}

.collection-item {
  position: relative;
  aspect-ratio: 1/1;
  overflow: hidden;
}

.collection-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.collection-item:hover img {
  transform: scale(1.1);
}

/* ===== UPDATED TEXT UI ===== */
.split-text {
  text-align: center; /* Design pramane center kela ahe */
}

.split-text h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 24px;
  letter-spacing: 0.25em; /* Modern Tracking */
  margin-bottom: 25px;
  text-transform: uppercase;
}

.split-paragraph p {
  font-family: 'Cormorant Garamond', serif; /* Serif font for premium look */
  font-style: italic;
  font-size: 17px;
  line-height: 1.6;
  max-width: 480px;
  margin: 0 auto;
  color: #333;
}

/* ===== RIGHT IMAGE WITH LINK ===== */
.split-right {
  position: relative;
  overflow: hidden;
}

.right-image-anchor {
  display: block;
  width: 100%;
  height: 100%;
}

.split-right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.split-right:hover img {
  transform: scale(1.05);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .split-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
}

@media (max-width: 768px) {
  .luxury-split { padding: 80px 0; }
  .collection-grid { gap: 16px; margin-bottom: 40px; }
  .split-text h3 { font-size: 18px; letter-spacing: 0.15em; }
  .split-paragraph p { font-size: 15px; }
}
</style>

{% schema %}
{
  "name": "Luxury Collection Split",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DISCOVER THE LATEST COLLECTIONS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph Text",
      "default": "Each Rosetta Fine Jewellery collection tells a story — of grace, strength, and timeless allure."
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Large Image"
    },
    {
      "type": "url",
      "id": "right_image_link",
      "label": "Right Image Link"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Luxury Collection Split",
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}