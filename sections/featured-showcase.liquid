<section class="featured-showcase">

  <div class="showcase-header">

    <div class="showcase-heading">
      <span class="showcase-subtitle">
        {{ section.settings.subtitle }}
      </span>
      <h2 class="showcase-title">
        {{ section.settings.heading }}
      </h2>
    </div>

  </div>

  <!-- Horizontal Scroll -->
  <div class="showcase-slider">

    {% for block in section.blocks %}
      <div class="showcase-item" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link }}">

          <div class="showcase-image">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.title }}"
                loading="lazy">
            {% endif %}
            <div class="showcase-overlay"></div>
          </div>

          <div class="showcase-info">
            <span class="showcase-category">
              {{ block.settings.category }}
            </span>
            <h3 class="showcase-product-title">
              {{ block.settings.title }}
            </h3>
          </div>

        </a>
      </div>
    {% endfor %}

  </div>

</section>


{% stylesheet %}

/* SECTION */
.featured-showcase {
  padding: 120px 0;
  background: #ffffff;
}

/* HEADER */
.showcase-header {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto 60px auto;
}

.showcase-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.showcase-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  opacity: 0.7;
  display: block;
  margin-bottom: 10px;
}

.showcase-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 40px;
  letter-spacing: 0.1em;
  font-weight: 300;
}

/* SLIDER */
.showcase-slider {
  display: flex;
  gap: 30px;
  overflow-x: auto;
  padding-left: 8%;
  padding-right: 5%;
  scroll-behavior: smooth;
}

.showcase-slider::-webkit-scrollbar {
  display: none;
}

.showcase-item {
  flex-shrink: 0;
  width: 320px;
  cursor: pointer;
}

/* IMAGE */
.showcase-image {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  margin-bottom: 20px;
}

.showcase-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.showcase-item:hover img {
  transform: scale(1.08);
}

.showcase-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.4),
    rgba(0,0,0,0.1),
    rgba(0,0,0,0)
  );
  opacity: 0;
  transition: opacity 0.5s ease;
}

.showcase-item:hover .showcase-overlay {
  opacity: 1;
}

/* INFO */
.showcase-category {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  opacity: 0.6;
}

.showcase-product-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 300;
  margin-top: 6px;
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .showcase-item {
    width: 260px;
  }

  .showcase-title {
    font-size: 32px;
  }
}

@media (max-width: 768px) {
  .featured-showcase {
    padding: 80px 0;
  }

  .showcase-item {
    width: 220px;
  }
}

{% endstylesheet %}


{% schema %}
{
  "name": "Featured Showcase",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOWCASE"
    }
  ],
  "blocks": [
    {
      "type": "showcase_item",
      "name": "Showcase Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Necklaces"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Diamond Necklace"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Showcase",
      "blocks": [
        { "type": "showcase_item" },
        { "type": "showcase_item" },
        { "type": "showcase_item" },
        { "type": "showcase_item" }
      ]
    }
  ]
}
{% endschema %}