<section class="featured-showcase">

  <div class="showcase-header">
    <div class="showcase-heading">
      <span class="showcase-subtitle">
        {{ section.settings.subtitle }}
      </span>
      <h2 class="showcase-title">
        {{ section.settings.heading }}
      </h2>
    </div>
  </div>

  <div class="showcase-wrapper">
    <div class="showcase-track">

      {% for block in section.blocks %}
        <div class="showcase-item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}">
            <div class="showcase-image">
              {% if block.settings.image %}
                <img 
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="showcase-overlay"></div>
            </div>

            <div class="showcase-info">
              <span class="showcase-category">
                {{ block.settings.category }}
              </span>
              <h3 class="showcase-product-title">
                {{ block.settings.title }}
              </h3>
            </div>
          </a>
        </div>
      {% endfor %}

      {% for block in section.blocks %}
        <div class="showcase-item">
          <a href="{{ block.settings.link }}">
            <div class="showcase-image">
              {% if block.settings.image %}
                <img 
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="showcase-overlay"></div>
            </div>

            <div class="showcase-info">
              <span class="showcase-category">
                {{ block.settings.category }}
              </span>
              <h3 class="showcase-product-title">
                {{ block.settings.title }}
              </h3>
            </div>
          </a>
        </div>
      {% endfor %}

    </div>
  </div>

</section>

{% stylesheet %}

.featured-showcase {
  padding: 120px 0;
  background: #ffffff;
  overflow: hidden;
}

.showcase-header {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto 60px auto;
}

.showcase-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  opacity: 0.7;
  margin-bottom: 10px;
}

.showcase-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 40px;
  font-weight: 300;
}

.showcase-wrapper {
  overflow: hidden;
}

.showcase-track {
  display: flex;
  gap: 30px;
  width: max-content;
  animation: autoScroll 35s linear infinite;
}

.showcase-wrapper:hover .showcase-track {
  animation-play-state: paused;
}

.showcase-item {
  flex-shrink: 0;
  width: 320px;
}

.showcase-image {
  aspect-ratio: 3/4;
  overflow: hidden;
  margin-bottom: 20px;
}

.showcase-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.showcase-item:hover img {
  transform: scale(1.08);
}

@keyframes autoScroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Featured Showcase",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOWCASE"
    }
  ],
  "blocks": [
    {
      "type": "showcase_item",
      "name": "Showcase Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "Necklaces"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Diamond Necklace"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Showcase",
      "blocks": [
        { "type": "showcase_item" },
        { "type": "showcase_item" },
        { "type": "showcase_item" },
        { "type": "showcase_item" }
      ]
    }
  ]
}
{% endschema %}