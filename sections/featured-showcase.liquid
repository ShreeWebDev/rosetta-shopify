<section class="featured-showcase">

  <div class="showcase-header">
    <div class="showcase-heading">
      <span class="showcase-subtitle">
        {{ section.settings.subtitle }}
      </span>
      <h2 class="showcase-title">
        {{ section.settings.heading }}
      </h2>
    </div>
  </div>

  <!-- AUTO SCROLL WRAPPER -->
  <div class="showcase-wrapper">
    <div class="showcase-track">

      {% for block in section.blocks %}
        <div class="showcase-item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}">
            <div class="showcase-image">
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="showcase-overlay"></div>
            </div>

            <div class="showcase-info">
              <span class="showcase-category">
                {{ block.settings.category }}
              </span>
              <h3 class="showcase-product-title">
                {{ block.settings.title }}
              </h3>
            </div>
          </a>
        </div>
      {% endfor %}

      <!-- DUPLICATE FOR INFINITE LOOP -->
      {% for block in section.blocks %}
        <div class="showcase-item">
          <a href="{{ block.settings.link }}">
            <div class="showcase-image">
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy">
              {% endif %}
              <div class="showcase-overlay"></div>
            </div>

            <div class="showcase-info">
              <span class="showcase-category">
                {{ block.settings.category }}
              </span>
              <h3 class="showcase-product-title">
                {{ block.settings.title }}
              </h3>
            </div>
          </a>
        </div>
      {% endfor %}

    </div>
  </div>

</section>


{% stylesheet %}

/* SECTION */
.featured-showcase {
  padding: 120px 0;
  background: #ffffff;
  overflow: hidden;
}

/* HEADER */
.showcase-header {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto 60px auto;
}

.showcase-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.showcase-subtitle {
  font-family: 'Inter', sans-serif;
  font-size: 12px;
  letter-spacing: 0.4em;
  text-transform: uppercase;
  opacity: 0.7;
  margin-bottom: 10px;
}

.showcase-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 40px;
  letter-spacing: 0.1em;
  font-weight: 300;
}

/* WRAPPER */
.showcase-wrapper {
  overflow: hidden;
  position: relative;
}

/* TRACK */
.showcase-track {
  display: flex;
  gap: 30px;
  width: max-content;
  animation: autoScroll 35s linear infinite;
}

/* PAUSE ON HOVER */
.showcase-wrapper:hover .showcase-track {
  animation-play-state: paused;
}

/* ITEM */
.showcase-item {
  flex-shrink: 0;
  width: 320px;
  cursor: pointer;
}

/* IMAGE */
.showcase-image {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  margin-bottom: 20px;
}

.showcase-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.showcase-item:hover img {
  transform: scale(1.08);
}

.showcase-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.4),
    rgba(0,0,0,0.1),
    rgba(0,0,0,0)
  );
  opacity: 0;
  transition: opacity 0.5s ease;
}

.showcase-item:hover .showcase-overlay {
  opacity: 1;
}

/* INFO */
.showcase-category {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  opacity: 0.6;
}

.showcase-product-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 300;
  margin-top: 6px;
}

/* AUTO SCROLL ANIMATION */
@keyframes autoScroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .showcase-item {
    width: 260px;
  }

  .showcase-title {
    font-size: 32px;
  }
}

@media (max-width: 768px) {
  .featured-showcase {
    padding: 80px 0;
  }

  .showcase-item {
    width: 220px;
  }
}

{% endstylesheet %}