<section class="lux-hero">
  {% if section.settings.image != blank %}
    <img 
      src="{{ section.settings.image | image_url: width: 2000 }}" 
      alt="{{ section.settings.image.alt | escape }}"
      class="lux-hero-img"
      loading="lazy"
    >
  {% endif %}
</section>

{% stylesheet %}

/* REMOVE SHOPIFY GAP ISSUE */
.shopify-section{
  max-width:100% !important;
  width:100% !important;
  margin-left: -50vw;
  margin-right: -50vw;
}

/* HERO FULL WIDTH FIX */
.lux-hero{
  width:100vw;
  margin-left:calc(-50vw + 50%);
  position:relative;
  overflow:hidden;
}

/* IMAGE */
.lux-hero-img{
  width:100%;
  height:90vh;
  object-fit:cover;
  display:block;
}

/* MOBILE */
@media(max-width:768px){
  .lux-hero-img{
    height:70vh;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero"
    }
  ]
}
{% endschema %}